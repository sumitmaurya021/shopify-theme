{% comment %}
  Renders breadcrumbs navigation with Schema.org BreadcrumbList structured microdata.
{% endcomment %}

{%- unless template == 'index' or template == 'cart' or template == '404' -%}
  <nav class="breadcrumbs page-width" role="navigation" aria-label="Breadcrumbs">
    <ol class="breadcrumbs__list" itemscope itemtype="https://schema.org/BreadcrumbList">
      <li class="breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
        <a href="{{ routes.root_url }}" class="breadcrumbs__link" itemprop="item">
          <span itemprop="name">Home</span>
        </a>
        <meta itemprop="position" content="1">
      </li>

      {%- case template.name -%}
        {%- when 'collection' -%}
          <li class="breadcrumbs__separator" aria-hidden="true">&rsaquo;</li>
          {%- if current_tags -%}
            <li class="breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
              <a href="{{ collection.url }}" class="breadcrumbs__link" itemprop="item">
                <span itemprop="name">{{ collection.title }}</span>
              </a>
              <meta itemprop="position" content="2">
            </li>
            <li class="breadcrumbs__separator" aria-hidden="true">&rsaquo;</li>
            <li class="breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
              <span class="breadcrumbs__current" itemprop="name" aria-current="page">{{ current_tags | join: " + " }}</span>
              <meta itemprop="position" content="3">
            </li>
          {%- else -%}
            <li class="breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
              <span class="breadcrumbs__current" itemprop="name" aria-current="page">{{ collection.title }}</span>
              <meta itemprop="position" content="2">
            </li>
          {%- endif -%}

        {%- when 'product' -%}
          {%- if collection.url -%}
            <li class="breadcrumbs__separator" aria-hidden="true">&rsaquo;</li>
            <li class="breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
              <a href="{{ collection.url }}" class="breadcrumbs__link" itemprop="item">
                <span itemprop="name">{{ collection.title }}</span>
              </a>
              <meta itemprop="position" content="2">
            </li>
            <li class="breadcrumbs__separator" aria-hidden="true">&rsaquo;</li>
            <li class="breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
              <span class="breadcrumbs__current" itemprop="name" aria-current="page">{{ product.title }}</span>
              <meta itemprop="position" content="3">
            </li>
          {%- else -%}
            <li class="breadcrumbs__separator" aria-hidden="true">&rsaquo;</li>
            <li class="breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
              <span class="breadcrumbs__current" itemprop="name" aria-current="page">{{ product.title }}</span>
              <meta itemprop="position" content="2">
            </li>
          {%- endif -%}

        {%- when 'blog' -%}
          <li class="breadcrumbs__separator" aria-hidden="true">&rsaquo;</li>
          {%- if current_tags -%}
            <li class="breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
              <a href="{{ blog.url }}" class="breadcrumbs__link" itemprop="item">
                <span itemprop="name">{{ blog.title }}</span>
              </a>
              <meta itemprop="position" content="2">
            </li>
            <li class="breadcrumbs__separator" aria-hidden="true">&rsaquo;</li>
            <li class="breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
              <span class="breadcrumbs__current" itemprop="name" aria-current="page">{{ current_tags | join: " + " }}</span>
              <meta itemprop="position" content="3">
            </li>
          {%- else -%}
            <li class="breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
              <span class="breadcrumbs__current" itemprop="name" aria-current="page">{{ blog.title }}</span>
              <meta itemprop="position" content="2">
            </li>
          {%- endif -%}

        {%- when 'article' -%}
          <li class="breadcrumbs__separator" aria-hidden="true">&rsaquo;</li>
          <li class="breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
            <a href="{{ blog.url }}" class="breadcrumbs__link" itemprop="item">
              <span itemprop="name">{{ blog.title }}</span>
            </a>
            <meta itemprop="position" content="2">
          </li>
          <li class="breadcrumbs__separator" aria-hidden="true">&rsaquo;</li>
          <li class="breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
            <span class="breadcrumbs__current" itemprop="name" aria-current="page">{{ article.title }}</span>
            <meta itemprop="position" content="3">
          </li>

        {%- when 'page' -%}
          <li class="breadcrumbs__separator" aria-hidden="true">&rsaquo;</li>
          <li class="breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
            <span class="breadcrumbs__current" itemprop="name" aria-current="page">{{ page.title }}</span>
            <meta itemprop="position" content="2">
          </li>

        {%- when 'search' -%}
          <li class="breadcrumbs__separator" aria-hidden="true">&rsaquo;</li>
          <li class="breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
            <span class="breadcrumbs__current" itemprop="name" aria-current="page">Search: "{{ search.terms }}"</span>
            <meta itemprop="position" content="2">
          </li>

        {%- else -%}
          <li class="breadcrumbs__separator" aria-hidden="true">&rsaquo;</li>
          <li class="breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
            <span class="breadcrumbs__current" itemprop="name" aria-current="page">{{ page_title }}</span>
            <meta itemprop="position" content="2">
          </li>
      {%- endcase -%}
    </ol>
  </nav>
{%- endunless -%}

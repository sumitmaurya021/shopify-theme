{% comment %}
  PREMIUM VIDEO WITH TEXT SECTION
  Immersive brand and craftsmanship storytelling with Shopify native video or external embeds.
{% endcomment %}

{%- liquid
  assign layout = section.settings.layout | default: 'video_first'
  assign aspect_ratio = section.settings.aspect_ratio | default: '16-9'
  assign color_scheme = section.settings.color_scheme | default: 'color-scheme-1'
-%}

<div class="video-with-text {{ color_scheme }}" id="VideoWithText-{{ section.id }}">
  <div class="section-container section-container--{{ section.settings.section_width | default: 'standard' }}">
    
    <div class="video-with-text__grid video-with-text__grid--{{ layout }}">
      
      {%- comment -%} Video Column {%- endcomment -%}
      <div class="video-with-text__media-col">
        <div class="video-with-text__media-wrapper video-with-text__media-wrapper--{{ aspect_ratio }}">
          {%- if section.settings.video != blank -%}
            {{ section.settings.video | video_tag:
              autoplay: section.settings.autoplay,
              loop: section.settings.autoplay,
              muted: section.settings.autoplay,
              controls: true,
              image_size: '1200x',
              class: 'video-with-text__video'
            }}
          {%- elsif section.settings.video_url != blank -%}
            {%- assign video_id = section.settings.video_url.id -%}
            {%- if section.settings.video_url.type == 'youtube' -%}
              <iframe 
                src="https://www.youtube.com/embed/{{ video_id }}?enablejsapi=1{% if section.settings.autoplay %}&autoplay=1&mute=1&loop=1{% endif %}" 
                class="video-with-text__iframe" 
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                allowfullscreen
                title="{{ section.settings.heading | escape }}"
              ></iframe>
            {%- elsif section.settings.video_url.type == 'vimeo' -%}
              <iframe 
                src="https://player.vimeo.com/video/{{ video_id }}{% if section.settings.autoplay %}?autoplay=1&muted=1&loop=1{% endif %}" 
                class="video-with-text__iframe" 
                allow="autoplay; fullscreen; picture-in-picture" 
                allowfullscreen
                title="{{ section.settings.heading | escape }}"
              ></iframe>
            {%- endif -%}
          {%- elsif section.settings.cover_image != blank -%}
            {{ section.settings.cover_image | image_url: width: 1200 | image_tag:
              class: 'video-with-text__cover-img',
              loading: 'lazy',
              alt: section.settings.heading | escape
            }}
            <div class="video-with-text__play-badge">
              {% render 'icon-library', icon: 'play' %}
            </div>
          {%- else -%}
            <div class="video-with-text__placeholder">
              {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
              <div class="video-with-text__play-badge">
                {% render 'icon-library', icon: 'play' %}
              </div>
            </div>
          {%- endif -%}
        </div>
      </div>

      {%- comment -%} Text Column {%- endcomment -%}
      <div class="video-with-text__text-col">
        <div class="video-with-text__content">
          {%- if section.settings.subheading != blank -%}
            <span class="video-with-text__subheading{% if section.settings.subheading_pill %} video-with-text__subheading--pill{% endif %}">
              {{ section.settings.subheading | escape }}
            </span>
          {%- endif -%}

          {%- if section.settings.heading != blank -%}
            <h2 class="video-with-text__heading video-with-text__heading--{{ section.settings.heading_size | default: 'md' }}">
              {{ section.settings.heading | escape }}
            </h2>
          {%- endif -%}

          {%- if section.settings.text != blank -%}
            <div class="video-with-text__text rte">
              {{ section.settings.text }}
            </div>
          {%- endif -%}

          {%- if section.settings.button_label != blank -%}
            <div class="video-with-text__actions">
              <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="btn btn--{{ section.settings.button_style | default: 'primary' }} btn--lg">
                {{ section.settings.button_label | escape }}
              </a>
            </div>
          {%- endif -%}
        </div>
      </div>

    </div>

  </div>
</div>

<style>
  #VideoWithText-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_mobile | default: 40 }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile | default: 40 }}px;
  }

  @media (min-width: 768px) {
    #VideoWithText-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_desktop | default: 80 }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop | default: 80 }}px;
    }
  }

  .video-with-text__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 900px) {
    .video-with-text__grid {
      grid-template-columns: 1fr 1fr;
      gap: 4.5rem;
    }

    .video-with-text__grid--text_first .video-with-text__media-col {
      order: 2;
    }
    .video-with-text__grid--text_first .video-with-text__text-col {
      order: 1;
    }
  }

  .video-with-text__media-wrapper {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background-color: #0a0a0c;
  }

  .video-with-text__media-wrapper--16-9 { aspect-ratio: 16 / 9; }
  .video-with-text__media-wrapper--4-3 { aspect-ratio: 4 / 3; }
  .video-with-text__media-wrapper--1-1 { aspect-ratio: 1 / 1; }
  .video-with-text__media-wrapper--9-16 { aspect-ratio: 9 / 16; max-height: 600px; margin: 0 auto; }

  .video-with-text__video,
  .video-with-text__iframe,
  .video-with-text__cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border: none;
  }

  .video-with-text__placeholder {
    width: 100%;
    height: 100%;
    min-height: 380px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    background: #1f2937;
    opacity: 0.4;
  }

  .video-with-text__play-badge {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 64px;
    height: 64px;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.9);
    color: #111827;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 10px 25px rgba(0,0,0,0.3);
    pointer-events: none;
  }

  .video-with-text__play-badge svg {
    margin-left: 3px;
  }

  .video-with-text__subheading {
    display: inline-block;
    font-size: 0.825rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-subtext, #6b7280);
    margin-bottom: 0.85rem;
  }

  .video-with-text__subheading--pill {
    padding: 0.35rem 0.95rem;
    border-radius: var(--radius-full);
    background: rgba(0, 0, 0, 0.05);
  }

  .video-with-text__heading {
    margin: 0 0 1rem 0;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.025em;
    color: var(--color-heading, #111827);
  }

  .video-with-text__heading--sm { font-size: clamp(1.25rem, 1.8vw, 1.5rem); }
  .video-with-text__heading--md { font-size: clamp(1.5rem, 2.2vw, 1.85rem); }
  .video-with-text__heading--lg { font-size: clamp(1.75rem, 2.8vw, 2.25rem); }

  .video-with-text__text {
    font-size: clamp(0.95rem, 1.2vw, 1.05rem);
    line-height: 1.6;
    color: var(--color-subtext, #4b5563);
    margin-bottom: 1.75rem;
  }

  .video-with-text__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
</style>

{% schema %}
{
  "name": "Video with text",
  "class": "shopify-section-video-with-text",
  "settings": [
    {
      "type": "header",
      "content": "Video Source"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Shopify hosted video"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "accept": ["youtube", "vimeo"],
      "label": "Or external YouTube/Vimeo URL"
    },
    {
      "type": "image_picker",
      "id": "cover_image",
      "label": "Poster / Cover image fallback"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay video (muted)",
      "default": true
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Video aspect ratio",
      "options": [
        { "value": "16-9", "label": "Landscape (16:9)" },
        { "value": "4-3", "label": "Standard (4:3)" },
        { "value": "1-1", "label": "Square (1:1)" },
        { "value": "9-16", "label": "Vertical Reel (9:16)" }
      ],
      "default": "16-9"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Desktop arrangement",
      "options": [
        { "value": "video_first", "label": "Video first, text second" },
        { "value": "text_first", "label": "Text first, video second" }
      ],
      "default": "video_first"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Inside The Atelier"
    },
    {
      "type": "checkbox",
      "id": "subheading_pill",
      "label": "Display subheading as pill badge",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Art of Slow Fashion"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "sm", "label": "Small" },
        { "value": "md", "label": "Medium" },
        { "value": "lg", "label": "Large" }
      ],
      "default": "md"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Description",
      "default": "<p>Step inside our Florence workshop where each piece undergoes seventy individual steps of tailoring, pressing, and hand-inspection by master artisans.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Explore The Craft"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "primary", "label": "Primary Solid" },
        { "value": "secondary", "label": "Secondary" },
        { "value": "outline", "label": "Outline" }
      ],
      "default": "primary"
    },
    {
      "type": "header",
      "content": "Style & Spacing"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Container width",
      "options": [
        { "value": "standard", "label": "Standard (1240px)" },
        { "value": "wide", "label": "Wide (1440px)" }
      ],
      "default": "standard"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "color-scheme-1", "label": "Clean White" },
        { "value": "color-scheme-2", "label": "Soft Warm" },
        { "value": "color-scheme-3", "label": "Muted Slate" },
        { "value": "color-scheme-4", "label": "Deep Charcoal" },
        { "value": "color-scheme-5", "label": "Onyx Black" }
      ],
      "default": "color-scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 140,
      "step": 10,
      "unit": "px",
      "label": "Desktop top padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 140,
      "step": 10,
      "unit": "px",
      "label": "Desktop bottom padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 80,
      "step": 10,
      "unit": "px",
      "label": "Mobile top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 80,
      "step": 10,
      "unit": "px",
      "label": "Mobile bottom padding",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Video with text",
      "settings": {
        "subheading": "Documentary Short",
        "heading": "Crafting Modern Heritage",
        "text": "<p>A behind-the-scenes journey into raw material sourcing and ethical fiber regeneration.</p>",
        "button_label": "Watch Full Film"
      }
    }
  ]
}
{% endschema %}

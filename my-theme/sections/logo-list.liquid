{% comment %}
  PREMIUM LOGO LIST & PRESS MARQUEE
  Showcase press endorsements, partner brands, or certifications with static grid or smooth marquee animation.
{% endcomment %}

{%- liquid
  assign display_mode = section.settings.display_mode | default: 'marquee'
  assign logo_height = section.settings.logo_height | default: 44
  assign color_scheme = section.settings.color_scheme | default: 'color-scheme-1'
-%}

<div class="logo-list {{ color_scheme }}" id="LogoList-{{ section.id }}">
  <div class="section-container section-container--{{ section.settings.section_width | default: 'standard' }}">
    
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      {% render 'section-header',
        subheading: section.settings.subheading,
        subheading_style: section.settings.subheading_style,
        heading: section.settings.heading,
        heading_size: section.settings.heading_size,
        alignment: 'center'
      %}
    {%- endif -%}

    {%- if display_mode == 'marquee' -%}
      <div class="marquee-wrapper logo-list__marquee{% if section.settings.grayscale %} logo-list--grayscale{% endif %}" style="--logo-height: {{ logo_height }}px;">
        <div class="marquee-content">
          {%- for block in section.blocks -%}
            <div class="logo-list__item" {{ block.shopify_attributes }}>
              {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" class="logo-list__link">{%- endif -%}
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: height: 120 | image_tag:
                    class: 'logo-list__img',
                    loading: 'lazy',
                    alt: block.settings.text | default: 'Brand partner logo' | escape
                  }}
                {%- else -%}
                  <span class="logo-list__text-badge">{{ block.settings.text | default: 'PARTNER' }}</span>
                {%- endif -%}
              {%- if block.settings.link != blank -%}</a>{%- endif -%}
            </div>
          {%- endfor -%}
        </div>
        <div class="marquee-content" aria-hidden="true">
          {%- for block in section.blocks -%}
            <div class="logo-list__item">
              {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" class="logo-list__link">{%- endif -%}
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: height: 120 | image_tag:
                    class: 'logo-list__img',
                    loading: 'lazy',
                    alt: block.settings.text | default: 'Brand partner logo' | escape
                  }}
                {%- else -%}
                  <span class="logo-list__text-badge">{{ block.settings.text | default: 'PARTNER' }}</span>
                {%- endif -%}
              {%- if block.settings.link != blank -%}</a>{%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- else -%}
      <div class="logo-list__grid logo-list__grid--{{ section.settings.columns_desktop | default: 5 }}{% if section.settings.grayscale %} logo-list--grayscale{% endif %}" style="--logo-height: {{ logo_height }}px;">
        {%- for block in section.blocks -%}
          <div class="logo-list__item" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" class="logo-list__link">{%- endif -%}
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: height: 120 | image_tag:
                  class: 'logo-list__img',
                  loading: 'lazy',
                  alt: block.settings.text | default: 'Brand partner logo' | escape
                }}
              {%- else -%}
                <span class="logo-list__text-badge">{{ block.settings.text | default: 'PARTNER' }}</span>
              {%- endif -%}
            {%- if block.settings.link != blank -%}</a>{%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</div>

<style>
  #LogoList-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_mobile | default: 30 }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile | default: 30 }}px;
  }

  @media (min-width: 768px) {
    #LogoList-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_desktop | default: 50 }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop | default: 50 }}px;
    }
  }

  .logo-list__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
    align-items: center;
    justify-content: center;
  }

  @media (min-width: 640px) {
    .logo-list__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .logo-list__grid--4 { grid-template-columns: repeat(4, 1fr); }
    .logo-list__grid--5 { grid-template-columns: repeat(5, 1fr); }
    .logo-list__grid--6 { grid-template-columns: repeat(6, 1fr); }
  }

  .logo-list__item {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.25rem;
  }

  .logo-list__img {
    height: var(--logo-height, 44px);
    width: auto;
    max-width: 160px;
    object-fit: contain;
    transition: all 0.25s ease;
  }

  .logo-list--grayscale .logo-list__img {
    filter: grayscale(100%);
    opacity: 0.6;
  }

  .logo-list--grayscale .logo-list__item:hover .logo-list__img {
    filter: grayscale(0%);
    opacity: 1;
    transform: scale(1.05);
  }

  .logo-list__text-badge {
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-heading, #111827);
    opacity: 0.65;
    transition: opacity 0.2s ease;
  }

  .logo-list__item:hover .logo-list__text-badge {
    opacity: 1;
  }

  .logo-list__link {
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    color: inherit;
  }
</style>

{% schema %}
{
  "name": "Logo list & Press",
  "class": "shopify-section-logo-list",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Press & Recognition"
    },
    {
      "type": "select",
      "id": "subheading_style",
      "label": "Subheading style",
      "options": [
        { "value": "plain", "label": "Plain" },
        { "value": "pill", "label": "Pill badge" }
      ],
      "default": "plain"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured In Leading Publications"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "sm", "label": "Small" },
        { "value": "md", "label": "Medium" }
      ],
      "default": "sm"
    },
    {
      "type": "header",
      "content": "Display & Style"
    },
    {
      "type": "select",
      "id": "display_mode",
      "label": "Display mode",
      "options": [
        { "value": "marquee", "label": "Continuous Marquee Ticker" },
        { "value": "grid", "label": "Clean Static Grid" }
      ],
      "default": "marquee"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Grid columns (Desktop)",
      "options": [
        { "value": "4", "label": "4 Columns" },
        { "value": "5", "label": "5 Columns" },
        { "value": "6", "label": "6 Columns" }
      ],
      "default": "5"
    },
    {
      "type": "range",
      "id": "logo_height",
      "min": 24,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Logo height",
      "default": 40
    },
    {
      "type": "checkbox",
      "id": "grayscale",
      "label": "Mute logos in grayscale until hover",
      "default": true
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "color-scheme-1", "label": "Clean White" },
        { "value": "color-scheme-2", "label": "Soft Warm" },
        { "value": "color-scheme-3", "label": "Muted Slate" }
      ],
      "default": "color-scheme-2"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 120,
      "step": 10,
      "unit": "px",
      "label": "Desktop top padding",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 120,
      "step": 10,
      "unit": "px",
      "label": "Desktop bottom padding",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 80,
      "step": 10,
      "unit": "px",
      "label": "Mobile top padding",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 80,
      "step": 10,
      "unit": "px",
      "label": "Mobile bottom padding",
      "default": 30
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Partner / Press Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo image"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Brand name / text fallback",
          "default": "VOGUE"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link URL (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Logo list & Press",
      "blocks": [
        { "type": "logo", "settings": { "text": "VOGUE" } },
        { "type": "logo", "settings": { "text": "GQ" } },
        { "type": "logo", "settings": { "text": "ELLE" } },
        { "type": "logo", "settings": { "text": "FORBES" } },
        { "type": "logo", "settings": { "text": "HARPER'S BAZAAR" } }
      ]
    }
  ]
}
{% endschema %}

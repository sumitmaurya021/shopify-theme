{% comment %}
  PREMIUM TESTIMONIALS & SOCIAL PROOF
  Showcase verified customer reviews, quotes, and star ratings in a Grid or Carousel.
{% endcomment %}

{%- liquid
  assign layout_style = section.settings.layout_style | default: 'grid'
  assign columns_desktop = section.settings.columns_desktop | default: 3
  assign color_scheme = section.settings.color_scheme | default: 'color-scheme-2'
-%}

<div class="testimonials {{ color_scheme }}" id="Testimonials-{{ section.id }}"{% if layout_style == 'carousel' %} data-section-slider{% endif %}>
  <div class="section-container section-container--{{ section.settings.section_width | default: 'standard' }}">
    
    <div class="testimonials__header-wrapper">
      {% render 'section-header',
        subheading: section.settings.subheading,
        subheading_style: section.settings.subheading_style,
        heading: section.settings.heading,
        heading_size: section.settings.heading_size,
        description: section.settings.description,
        alignment: section.settings.heading_alignment
      %}

      {%- if layout_style == 'carousel' -%}
        <div class="testimonials__nav-actions">
          <button type="button" class="section-slider__arrow" data-slider-prev aria-label="Previous review">
            {% render 'icon-library', icon: 'arrow-left' %}
          </button>
          <button type="button" class="section-slider__arrow" data-slider-next aria-label="Next review">
            {% render 'icon-library', icon: 'arrow-right' %}
          </button>
        </div>
      {%- endif -%}
    </div>

    {%- if layout_style == 'carousel' -%}
      <div class="section-slider__track" tabindex="0" role="region" aria-label="Customer reviews carousel">
        {%- for block in section.blocks -%}
          <div class="testimonials__card testimonials__card--carousel section-slider__slide card-base card-base--elevated" {{ block.shopify_attributes }}>
            <div class="testimonials__quote-icon">
              {% render 'icon-library', icon: 'quote' %}
            </div>

            {% render 'rating-stars', rating: block.settings.rating, size: 'sm' %}

            {%- if block.settings.title != blank -%}
              <h3 class="testimonials__card-title">{{ block.settings.title | escape }}</h3>
            {%- endif -%}

            <div class="testimonials__quote rte">
              {{ block.settings.quote }}
            </div>

            <div class="testimonials__author">
              {%- if block.settings.author_image != blank -%}
                {{ block.settings.author_image | image_url: width: 100 | image_tag:
                  class: 'testimonials__avatar',
                  loading: 'lazy',
                  alt: block.settings.author | escape
                }}
              {%- endif -%}
              <div>
                <strong class="testimonials__name">{{ block.settings.author | escape }}</strong>
                {%- if block.settings.author_info != blank -%}
                  <span class="testimonials__info">{{ block.settings.author_info | escape }}</span>
                {%- endif -%}
                {%- if block.settings.verified -%}
                  <span class="badge badge--verified" style="margin-top: 0.35rem;">
                    {% render 'icon-library', icon: 'check', class: 'badge__icon' %}
                    Verified Buyer
                  </span>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="testimonials__grid testimonials__grid--d-{{ columns_desktop }}">
        {%- for block in section.blocks -%}
          <div class="testimonials__card card-base card-base--elevated" {{ block.shopify_attributes }}>
            <div class="testimonials__rating-wrap">
              {% render 'rating-stars', rating: block.settings.rating, size: 'sm' %}
              {%- if block.settings.verified -%}
                <span class="badge badge--verified">Verified</span>
              {%- endif -%}
            </div>

            {%- if block.settings.title != blank -%}
              <h3 class="testimonials__card-title">{{ block.settings.title | escape }}</h3>
            {%- endif -%}

            <div class="testimonials__quote rte">
              {{ block.settings.quote }}
            </div>

            <div class="testimonials__author">
              {%- if block.settings.author_image != blank -%}
                {{ block.settings.author_image | image_url: width: 100 | image_tag:
                  class: 'testimonials__avatar',
                  loading: 'lazy',
                  alt: block.settings.author | escape
                }}
              {%- endif -%}
              <div>
                <strong class="testimonials__name">{{ block.settings.author | escape }}</strong>
                {%- if block.settings.author_info != blank -%}
                  <span class="testimonials__info">{{ block.settings.author_info | escape }}</span>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</div>

<style>
  #Testimonials-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_mobile | default: 40 }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile | default: 40 }}px;
  }

  @media (min-width: 768px) {
    #Testimonials-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_desktop | default: 80 }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop | default: 80 }}px;
    }
  }

  .testimonials__header-wrapper {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 2rem;
  }

  .testimonials__nav-actions {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 2.75rem;
  }

  .testimonials__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .testimonials__grid--d-2 { grid-template-columns: repeat(2, 1fr); gap: 2rem; }
    .testimonials__grid--d-3 { grid-template-columns: repeat(3, 1fr); gap: 2rem; }
    .testimonials__grid--d-4 { grid-template-columns: repeat(4, 1fr); gap: 1.5rem; }
  }

  .testimonials__card {
    padding: 2.5rem 2.25rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    position: relative;
    background: var(--color-card-bg, #ffffff);
    border: 1px solid var(--color-card-border, var(--color-border, #edebe6));
    border-radius: var(--radius-lg);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.03);
    transition: transform var(--transition-normal), box-shadow var(--transition-normal), border-color var(--transition-normal);
  }

  .testimonials__card:hover {
    transform: translateY(-5px);
    box-shadow: 0 18px 36px -8px rgba(0, 0, 0, 0.08);
    border-color: rgba(0, 0, 0, 0.14);
  }

  .testimonials__card--carousel {
    flex: 0 0 calc(100% - 2rem);
  }

  @media (min-width: 768px) {
    .testimonials__card--carousel {
      flex: 0 0 calc(50% - 1rem);
    }
  }

  @media (min-width: 1024px) {
    .testimonials__card--carousel {
      flex: 0 0 calc(33.333% - 1rem);
    }
  }

  .testimonials__quote-icon {
    position: absolute;
    top: 1.75rem;
    right: 1.75rem;
    opacity: 0.08;
    color: var(--color-heading, #111827);
  }

  .testimonials__quote-icon svg {
    width: 36px;
    height: 36px;
  }

  .testimonials__rating-wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .testimonials__card-title {
    font-size: 1.15rem;
    font-weight: 700;
    margin: 0.75rem 0 0.5rem 0;
    letter-spacing: -0.01em;
    color: var(--color-heading, #111827);
  }

  .testimonials__quote {
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--color-subtext, #4b5563);
    margin-bottom: 1.75rem;
    flex-grow: 1;
  }

  .testimonials__author {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border, #f3f4f6);
  }

  .testimonials__avatar {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-full);
    object-fit: cover;
  }

  .testimonials__name {
    display: block;
    font-size: 0.95rem;
    color: var(--color-heading, #111827);
  }

  .testimonials__info {
    display: block;
    font-size: 0.8rem;
    color: var(--color-subtext, #6b7280);
  }

  .badge__icon {
    width: 13px;
    height: 13px;
  }
</style>

{% schema %}
{
  "name": "Testimonials",
  "class": "shopify-section-testimonials",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Loved By Over 25,000 Clients"
    },
    {
      "type": "select",
      "id": "subheading_style",
      "label": "Subheading style",
      "options": [
        { "value": "plain", "label": "Plain" },
        { "value": "pill", "label": "Pill badge" }
      ],
      "default": "pill"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What Our Community Says"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "sm", "label": "Small" },
        { "value": "md", "label": "Medium" },
        { "value": "lg", "label": "Large" }
      ],
      "default": "md"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layout presentation",
      "options": [
        { "value": "grid", "label": "Static Grid" },
        { "value": "carousel", "label": "Swipeable Carousel" }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Grid columns (Desktop)",
      "options": [
        { "value": "2", "label": "2 Columns" },
        { "value": "3", "label": "3 Columns" },
        { "value": "4", "label": "4 Columns" }
      ],
      "default": "3"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Container width",
      "options": [
        { "value": "standard", "label": "Standard (1240px)" },
        { "value": "wide", "label": "Wide (1440px)" }
      ],
      "default": "standard"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "color-scheme-1", "label": "Clean White" },
        { "value": "color-scheme-2", "label": "Soft Warm" },
        { "value": "color-scheme-3", "label": "Muted Slate" }
      ],
      "default": "color-scheme-2"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 140,
      "step": 10,
      "unit": "px",
      "label": "Desktop top padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 140,
      "step": 10,
      "unit": "px",
      "label": "Desktop bottom padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 80,
      "step": 10,
      "unit": "px",
      "label": "Mobile top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 80,
      "step": 10,
      "unit": "px",
      "label": "Mobile bottom padding",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Review card",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Star rating",
          "default": 5
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Verified Buyer badge",
          "default": true
        },
        {
          "type": "text",
          "id": "title",
          "label": "Review headline",
          "default": "Exceptional Quality & Fit"
        },
        {
          "type": "richtext",
          "id": "quote",
          "label": "Review text",
          "default": "<p>\"The drape, texture, and stitching are on par with couture pieces five times the price. I receive compliments every single time I wear it.\"</p>"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Customer name",
          "default": "Elena Rostova"
        },
        {
          "type": "text",
          "id": "author_info",
          "label": "Subtitle / Location",
          "default": "London, UK"
        },
        {
          "type": "image_picker",
          "id": "author_image",
          "label": "Customer photo (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "title": "Sublime craftsmanship",
            "quote": "<p>\"The fabric feel is extraordinary. It has survived multiple seasons and still looks brand new. Truly an investment piece.\"</p>",
            "author": "Claire Beaumont",
            "author_info": "Paris, France"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "title": "Unmatched attention to detail",
            "quote": "<p>\"Arrived beautifully packaged within two days. The customer service concierge was attentive and helpful with sizing advice.\"</p>",
            "author": "Marcus Vance",
            "author_info": "New York, USA"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "title": "My new everyday staple",
            "quote": "<p>\"Clean lines, sustainable origins, and effortless versatility. I ended up purchasing two more colors the next week.\"</p>",
            "author": "Sofia Tanaka",
            "author_info": "Tokyo, Japan"
          }
        }
      ]
    }
  ]
}
{% endschema %}

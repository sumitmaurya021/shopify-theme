{% comment %}
  PREMIUM MULTI-COLUMN SECTION
  Showcase brand features, value propositions, craftsmanship pillars, or services.
{% endcomment %}

{%- liquid
  assign columns_desktop = section.settings.columns_desktop | default: 3
  assign columns_mobile = section.settings.columns_mobile | default: 1
  assign card_style = section.settings.card_style | default: 'elevated'
  assign color_scheme = section.settings.color_scheme | default: 'color-scheme-2'
-%}

<div class="multi-column {{ color_scheme }}" id="MultiColumn-{{ section.id }}">
  <div class="section-container section-container--{{ section.settings.section_width | default: 'standard' }}">
    
    {% render 'section-header',
      subheading: section.settings.subheading,
      subheading_style: section.settings.subheading_style,
      heading: section.settings.heading,
      heading_size: section.settings.heading_size,
      description: section.settings.description,
      alignment: section.settings.heading_alignment,
      button_label: section.settings.button_label,
      button_link: section.settings.button_link,
      button_style: section.settings.button_style
    %}

    <div class="multi-column__grid multi-column__grid--d-{{ columns_desktop }} multi-column__grid--m-{{ columns_mobile }}">
      {%- for block in section.blocks -%}
        <div 
          class="multi-column__item card-base card-base--{{ card_style }} text-{{ block.settings.alignment | default: 'center' }}"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.show_icon and block.settings.icon != 'none' -%}
            <div class="multi-column__icon-wrapper multi-column__icon-wrapper--{{ block.settings.icon_style | default: 'pill' }}">
              {% render 'icon-library', icon: block.settings.icon, class: 'multi-column__icon' %}
            </div>
          {%- elsif block.settings.image != blank -%}
            <div class="multi-column__image-wrapper">
              {{ block.settings.image | image_url: width: 600 | image_tag:
                class: 'multi-column__image',
                loading: 'lazy',
                widths: '240, 360, 480, 600',
                alt: block.settings.title | default: 'Feature image' | escape
              }}
            </div>
          {%- endif -%}

          <div class="multi-column__text-wrapper">
            {%- if block.settings.title != blank -%}
              <h3 class="multi-column__title">{{ block.settings.title | escape }}</h3>
            {%- endif -%}

            {%- if block.settings.text != blank -%}
              <div class="multi-column__text rte">
                {{ block.settings.text }}
              </div>
            {%- endif -%}

            {%- if block.settings.link_label != blank and block.settings.link_url != blank -%}
              <a href="{{ block.settings.link_url }}" class="multi-column__link">
                {{ block.settings.link_label | escape }} &rarr;
              </a>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>

  </div>
</div>

<style>
  #MultiColumn-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_mobile | default: 40 }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile | default: 40 }}px;
  }

  @media (min-width: 768px) {
    #MultiColumn-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_desktop | default: 80 }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop | default: 80 }}px;
    }
  }

  .multi-column__grid {
    display: grid;
    gap: 1.5rem;
  }

  .multi-column__grid--m-1 { grid-template-columns: 1fr; }
  .multi-column__grid--m-2 { grid-template-columns: 1fr 1fr; }

  @media (min-width: 768px) {
    .multi-column__grid--d-2 { grid-template-columns: repeat(2, 1fr); gap: 2rem; }
    .multi-column__grid--d-3 { grid-template-columns: repeat(3, 1fr); gap: 2rem; }
    .multi-column__grid--d-4 { grid-template-columns: repeat(4, 1fr); gap: 1.75rem; }
    .multi-column__grid--d-5 { grid-template-columns: repeat(5, 1fr); gap: 1.5rem; }
  }

  .multi-column__item {
    padding: 2.5rem 2rem;
    display: flex;
    flex-direction: column;
    height: 100%;
    border-radius: var(--radius-lg);
    background: var(--color-card-bg, #ffffff);
    border: 1px solid var(--color-card-border, var(--color-border, #edebe6));
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.03);
    transition: transform var(--transition-normal), box-shadow var(--transition-normal), border-color var(--transition-normal);
  }

  .multi-column__item:hover {
    transform: translateY(-5px);
    box-shadow: 0 18px 36px -8px rgba(0, 0, 0, 0.08);
    border-color: rgba(0, 0, 0, 0.15);
  }

  .card-base--flat.multi-column__item {
    background: transparent;
    border: none;
    box-shadow: none;
    padding-left: 0.5rem;
    padding-right: 0.5rem;
  }

  .multi-column__icon-wrapper {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.5rem;
    color: var(--color-heading, #111827);
  }

  .multi-column__icon-wrapper--pill {
    width: 58px;
    height: 58px;
    border-radius: var(--radius-full);
    background-color: var(--color-card-bg, #ffffff);
    border: 1px solid var(--color-border, #e5e3dc);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.04);
  }

  .text-center .multi-column__icon-wrapper {
    margin-left: auto;
    margin-right: auto;
  }

  .multi-column__icon {
    width: 28px;
    height: 28px;
  }

  .multi-column__image-wrapper {
    border-radius: var(--radius-md);
    overflow: hidden;
    margin-bottom: 1.25rem;
    aspect-ratio: 16 / 10;
  }

  .multi-column__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .multi-column__title {
    font-size: 1.2rem;
    font-weight: 700;
    margin: 0 0 0.65rem 0;
    color: var(--color-heading, #111827);
    letter-spacing: -0.01em;
  }

  .multi-column__text {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-subtext, #4b5563);
    margin: 0;
  }

  .multi-column__link {
    display: inline-block;
    margin-top: 1.25rem;
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--color-heading, #111827);
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: opacity 0.2s ease;
  }

  .multi-column__link:hover {
    opacity: 0.7;
  }
</style>

{% schema %}
{
  "name": "Multicolumn",
  "class": "shopify-section-multicolumn",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Why Choose Us"
    },
    {
      "type": "select",
      "id": "subheading_style",
      "label": "Subheading style",
      "options": [
        { "value": "plain", "label": "Plain" },
        { "value": "pill", "label": "Pill badge" }
      ],
      "default": "pill"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Uncompromising Quality In Every Detail"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "sm", "label": "Small" },
        { "value": "md", "label": "Medium" },
        { "value": "lg", "label": "Large" }
      ],
      "default": "md"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Engineered for longevity, tailored for elegance, and created with reverence for natural resources.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Header button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Header button link"
    },
    {
      "type": "header",
      "content": "Layout & Grid"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Desktop columns",
      "options": [
        { "value": "2", "label": "2 Columns" },
        { "value": "3", "label": "3 Columns" },
        { "value": "4", "label": "4 Columns" },
        { "value": "5", "label": "5 Columns" }
      ],
      "default": "3"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Mobile columns",
      "options": [
        { "value": "1", "label": "1 Column" },
        { "value": "2", "label": "2 Columns" }
      ],
      "default": "1"
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "Card appearance",
      "options": [
        { "value": "elevated", "label": "Elevated card" },
        { "value": "bordered", "label": "Bordered outline" },
        { "value": "flat", "label": "Flat seamless" }
      ],
      "default": "elevated"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Container width",
      "options": [
        { "value": "standard", "label": "Standard (1240px)" },
        { "value": "wide", "label": "Wide (1440px)" }
      ],
      "default": "standard"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "color-scheme-1", "label": "Clean White" },
        { "value": "color-scheme-2", "label": "Soft Warm" },
        { "value": "color-scheme-3", "label": "Muted Slate" },
        { "value": "color-scheme-4", "label": "Deep Charcoal" },
        { "value": "color-scheme-5", "label": "Onyx Black" }
      ],
      "default": "color-scheme-2"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 140,
      "step": 10,
      "unit": "px",
      "label": "Desktop top padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 140,
      "step": 10,
      "unit": "px",
      "label": "Desktop bottom padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 80,
      "step": 10,
      "unit": "px",
      "label": "Mobile top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 80,
      "step": 10,
      "unit": "px",
      "label": "Mobile bottom padding",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Feature column",
      "settings": [
        {
          "type": "checkbox",
          "id": "show_icon",
          "label": "Show icon",
          "default": true
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "shield-check", "label": "Shield Check (Warranty)" },
            { "value": "truck", "label": "Truck (Free Shipping)" },
            { "value": "refresh-cw", "label": "Refresh (Easy Returns)" },
            { "value": "leaf", "label": "Leaf (Eco / Sustainable)" },
            { "value": "sparkle", "label": "Sparkle (Premium Craft)" },
            { "value": "lock", "label": "Lock (Secure Payment)" },
            { "value": "award", "label": "Award (Certified)" },
            { "value": "gift", "label": "Gift (Complimentary)" }
          ],
          "default": "truck"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Or custom image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Complimentary Worldwide Delivery"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Description",
          "default": "<p>Fast, carbon-neutral shipping on all orders over $150 with dedicated doorstep tracking.</p>"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link URL"
        },
        {
          "type": "select",
          "id": "alignment",
          "label": "Content alignment",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" }
          ],
          "default": "center"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Multicolumn",
      "blocks": [
        {
          "type": "column",
          "settings": {
            "icon": "truck",
            "title": "Complimentary Express Delivery",
            "text": "<p>Carbon-neutral shipping delivered right to your door with full live tracking.</p>"
          }
        },
        {
          "type": "column",
          "settings": {
            "icon": "leaf",
            "title": "Ethically Sourced Materials",
            "text": "<p>100% organic, GOTS-certified fabrics woven under fair trade artisan standards.</p>"
          }
        },
        {
          "type": "column",
          "settings": {
            "icon": "shield-check",
            "title": "Lifetime Quality Guarantee",
            "text": "<p>Crafted to endure. If your piece requires care or repair, our concierge will handle it.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}

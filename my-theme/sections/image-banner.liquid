{% comment %}
  IMAGE BANNER / HERO SECTION
  High-impact homepage hero banner with customizable media, headline, and CTA.
{% endcomment %}

<div class="image-banner" id="Banner-{{ section.id }}">
  {%- if section.settings.image != blank -%}
    {{ section.settings.image | image_url: width: 2000 | image_tag:
      class: 'image-banner__image',
      loading: 'eager',
      widths: '600, 900, 1200, 1600, 2000',
      alt: section.settings.heading | escape
    }}
  {%- else -%}
    <div class="image-banner__placeholder">
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
    </div>
  {%- endif -%}

  <div class="image-banner__overlay">
    <div class="image-banner__content page-width text-center">
      {%- if section.settings.subheading != blank -%}
        <span class="image-banner__subheading">{{ section.settings.subheading | escape }}</span>
      {%- endif -%}

      <h2 class="image-banner__title">{{ section.settings.heading | default: 'Welcome to Our Store' | escape }}</h2>

      {%- if section.settings.text != blank -%}
        <p class="image-banner__text">{{ section.settings.text | escape }}</p>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="btn btn--primary image-banner__btn">
          {{ section.settings.button_label | escape }}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

<style>
  #Banner-{{ section.id }} {
    position: relative;
    width: 100%;
    min-height: {{ section.settings.banner_height }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background-color: #111827;
  }

  #Banner-{{ section.id }} .image-banner__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: {{ section.settings.image_opacity | divided_by: 100.0 }};
  }

  #Banner-{{ section.id }} .image-banner__placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.25;
  }

  #Banner-{{ section.id }} .image-banner__overlay {
    position: relative;
    z-index: 2;
    padding: 3rem 1.5rem;
    color: #ffffff;
  }

  #Banner-{{ section.id }} .image-banner__subheading {
    display: block;
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
    color: #e5e7eb;
  }

  #Banner-{{ section.id }} .image-banner__title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 900;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin: 0 0 1rem 0;
  }

  #Banner-{{ section.id }} .image-banner__text {
    font-size: clamp(1rem, 2vw, 1.25rem);
    color: #d1d5db;
    max-width: 640px;
    margin: 0 auto 2rem auto;
    line-height: 1.6;
  }

  #Banner-{{ section.id }} .image-banner__btn {
    background-color: #ffffff;
    color: #111827;
    border-color: #ffffff;
    padding: 0.95rem 2.25rem;
    font-size: 1rem;
  }

  #Banner-{{ section.id }} .image-banner__btn:hover {
    background-color: #f3f4f6;
    color: #000000;
  }
</style>

{% schema %}
{
  "name": "Image banner",
  "class": "shopify-section-image-banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Banner image"
    },
    {
      "type": "range",
      "id": "banner_height",
      "label": "Banner height",
      "min": 350,
      "max": 750,
      "step": 25,
      "unit": "px",
      "default": 550
    },
    {
      "type": "range",
      "id": "image_opacity",
      "label": "Image opacity",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 75
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "New Arrivals"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Discover Our Latest Collection"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "Shop premium essentials crafted with unmatched quality and modern aesthetics."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Image banner"
    }
  ]
}
{% endschema %}

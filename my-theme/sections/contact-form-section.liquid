{% comment %}
  PREMIUM CONTACT FORM & CONCIERGE SECTION
  Universal contact section with support sidebar, responsive inputs, and Shopify contact form integration.
{% endcomment %}

{%- liquid
  assign color_scheme = section.settings.color_scheme | default: 'color-scheme-1'
-%}

<div class="contact-section {{ color_scheme }}" id="Contact-{{ section.id }}">
  <div class="section-container section-container--{{ section.settings.section_width | default: 'standard' }}">
    
    <div class="contact-section__grid">
      
      {%- comment -%} Sidebar / Support Info {%- endcomment -%}
      <div class="contact-section__info-col">
        {%- if section.settings.subheading != blank -%}
          <span class="contact-section__subheading{% if section.settings.subheading_pill %} contact-section__subheading--pill{% endif %}">
            {{ section.settings.subheading | escape }}
          </span>
        {%- endif -%}

        <h2 class="contact-section__heading">
          {{ section.settings.heading | default: 'Get In Touch' | escape }}
        </h2>

        {%- if section.settings.text != blank -%}
          <div class="contact-section__text rte">
            {{ section.settings.text }}
          </div>
        {%- endif -%}

        <div class="contact-section__details">
          {%- if section.settings.email != blank -%}
            <div class="contact-section__detail-item">
              {% render 'icon-library', icon: 'mail' %}
              <div>
                <strong>Email Concierge</strong>
                <a href="mailto:{{ section.settings.email }}">{{ section.settings.email | escape }}</a>
              </div>
            </div>
          {%- endif -%}

          {%- if section.settings.phone != blank -%}
            <div class="contact-section__detail-item">
              {% render 'icon-library', icon: 'phone' %}
              <div>
                <strong>Phone & WhatsApp</strong>
                <a href="tel:{{ section.settings.phone }}">{{ section.settings.phone | escape }}</a>
              </div>
            </div>
          {%- endif -%}

          {%- if section.settings.address != blank -%}
            <div class="contact-section__detail-item">
              {% render 'icon-library', icon: 'map-pin' %}
              <div>
                <strong>Studio & Flagship</strong>
                <span>{{ section.settings.address | escape }}</span>
              </div>
            </div>
          {%- endif -%}
        </div>
      </div>

      {%- comment -%} Form Column {%- endcomment -%}
      <div class="contact-section__form-col">
        <div class="contact-section__form-wrapper card-base card-base--bordered">
          {%- form 'contact', id: 'ContactSectionForm', class: 'contact-form' -%}
            {%- if form.posted_successfully? -%}
              <div class="contact-form__success card-base card-base--bordered" role="status">
                {% render 'icon-library', icon: 'check', class: 'contact-form__success-icon' %}
                <span>Thank you for reaching out! Our client concierge will respond within 24 business hours.</span>
              </div>
            {%- else -%}
              {%- if form.errors -%}
                <div class="contact-form__error" role="alert">
                  {{ form.errors | default_errors }}
                </div>
              {%- endif -%}

              <div class="contact-form__row">
                <div class="contact-form__field">
                  <label for="ContactFormName-{{ section.id }}" class="contact-form__label">Full Name</label>
                  <input 
                    type="text" 
                    id="ContactFormName-{{ section.id }}" 
                    name="contact[name]" 
                    class="contact-form__input" 
                    placeholder="Your name" 
                    value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                    required
                  >
                </div>

                <div class="contact-form__field">
                  <label for="ContactFormEmail-{{ section.id }}" class="contact-form__label">Email Address</label>
                  <input 
                    type="email" 
                    id="ContactFormEmail-{{ section.id }}" 
                    name="contact[email]" 
                    class="contact-form__input" 
                    placeholder="name@example.com" 
                    value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                    required
                  >
                </div>
              </div>

              <div class="contact-form__field">
                <label for="ContactFormSubject-{{ section.id }}" class="contact-form__label">Inquiry Subject</label>
                <select id="ContactFormSubject-{{ section.id }}" name="contact[subject]" class="contact-form__select">
                  <option value="General Inquiry">General Inquiry</option>
                  <option value="Order & Shipping Status">Order & Shipping Status</option>
                  <option value="Sizing & Style Advice">Sizing & Style Advice</option>
                  <option value="Returns & Exchanges">Returns & Exchanges</option>
                  <option value="Press & Wholesale">Press & Wholesale</option>
                </select>
              </div>

              <div class="contact-form__field">
                <label for="ContactFormMessage-{{ section.id }}" class="contact-form__label">Message</label>
                <textarea 
                  rows="5" 
                  id="ContactFormMessage-{{ section.id }}" 
                  name="contact[body]" 
                  class="contact-form__textarea" 
                  placeholder="How can our team assist you today?" 
                  required
                >{{ form.body }}</textarea>
              </div>

              <button type="submit" class="btn btn--primary btn--lg contact-form__submit">
                Send Message &rarr;
              </button>
            {%- endif -%}
          {%- endform -%}
        </div>
      </div>

    </div>

  </div>
</div>

<style>
  #Contact-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_mobile | default: 40 }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile | default: 40 }}px;
  }

  @media (min-width: 768px) {
    #Contact-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_desktop | default: 80 }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop | default: 80 }}px;
    }
  }

  .contact-section__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 900px) {
    .contact-section__grid {
      grid-template-columns: 5fr 7fr;
      gap: 4.5rem;
    }
  }

  .contact-section__subheading {
    display: inline-block;
    font-size: 0.825rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-subtext, #6b7280);
    margin-bottom: 0.85rem;
  }

  .contact-section__subheading--pill {
    padding: 0.35rem 0.95rem;
    border-radius: var(--radius-full);
    background: rgba(0, 0, 0, 0.05);
  }

  .contact-section__heading {
    margin: 0 0 1rem 0;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: var(--color-heading, #111827);
    font-size: clamp(2rem, 3.5vw, 2.75rem);
  }

  .contact-section__text {
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--color-subtext, #4b5563);
    margin-bottom: 2rem;
  }

  .contact-section__details {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .contact-section__detail-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    color: var(--color-subtext, #4b5563);
  }

  .contact-section__detail-item svg {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
    color: var(--color-heading, #111827);
    margin-top: 2px;
  }

  .contact-section__detail-item strong {
    display: block;
    color: var(--color-heading, #111827);
    font-size: 0.95rem;
  }

  .contact-section__detail-item a {
    color: inherit;
    text-decoration: underline;
  }

  .contact-section__form-wrapper {
    padding: 2.5rem 2rem;
    background: var(--color-card-bg, #ffffff);
  }

  .contact-form__row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .contact-form__row {
      grid-template-columns: 1fr 1fr;
    }
  }

  .contact-form__field {
    margin-bottom: 1.25rem;
  }

  .contact-form__label {
    display: block;
    font-size: 0.85rem;
    font-weight: 700;
    margin-bottom: 0.45rem;
    color: var(--color-heading, #111827);
  }

  .contact-form__input,
  .contact-form__select,
  .contact-form__textarea {
    width: 100%;
    padding: 0.85rem 1.15rem;
    border: 1px solid var(--color-border, #d1d5db);
    border-radius: var(--radius-md);
    font-family: inherit;
    font-size: 0.95rem;
    background: #ffffff;
    color: #111827;
  }

  .contact-form__input:focus,
  .contact-form__select:focus,
  .contact-form__textarea:focus {
    outline: none;
    border-color: #111827;
    box-shadow: 0 0 0 3px rgba(17, 24, 39, 0.1);
  }

  .contact-form__submit {
    width: 100%;
    margin-top: 0.5rem;
  }

  .contact-form__success {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1.25rem;
    background-color: #ecfdf5;
    color: #065f46;
    font-size: 0.925rem;
    font-weight: 600;
  }

  .contact-form__success-icon {
    width: 20px;
    height: 20px;
    color: #059669;
  }
</style>

{% schema %}
{
  "name": "Contact form & Concierge",
  "class": "shopify-section-contact",
  "settings": [
    {
      "type": "header",
      "content": "Content & Details"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Client Care Concierge"
    },
    {
      "type": "checkbox",
      "id": "subheading_pill",
      "label": "Display subheading as pill badge",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "We Are Here To Assist"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Description",
      "default": "<p>Whether you require assistance with sizing, personal tailoring advice, or shipping inquiries, our style advisors are delighted to assist.</p>"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Concierge email",
      "default": "concierge@yourstore.com"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone / WhatsApp",
      "default": "+1 (800) 555-0199"
    },
    {
      "type": "text",
      "id": "address",
      "label": "Flagship address",
      "default": "48 Mercer Street, Soho, New York, NY"
    },
    {
      "type": "header",
      "content": "Style & Spacing"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Container width",
      "options": [
        { "value": "standard", "label": "Standard (1240px)" },
        { "value": "wide", "label": "Wide (1440px)" }
      ],
      "default": "standard"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "color-scheme-1", "label": "Clean White" },
        { "value": "color-scheme-2", "label": "Soft Warm" },
        { "value": "color-scheme-3", "label": "Muted Slate" }
      ],
      "default": "color-scheme-2"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 140,
      "step": 10,
      "unit": "px",
      "label": "Desktop top padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 140,
      "step": 10,
      "unit": "px",
      "label": "Desktop bottom padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 80,
      "step": 10,
      "unit": "px",
      "label": "Mobile top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 80,
      "step": 10,
      "unit": "px",
      "label": "Mobile bottom padding",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Contact form & Concierge"
    }
  ]
}
{% endschema %}

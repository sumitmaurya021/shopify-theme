{% comment %}
  PREMIUM STATS & METRICS COUNTER
  Highlight key figures, customer satisfaction, sustainable impact, or milestones.
{% endcomment %}

{%- liquid
  assign columns_desktop = section.settings.columns_desktop | default: 4
  assign color_scheme = section.settings.color_scheme | default: 'color-scheme-4'
-%}

<div class="stats-counter {{ color_scheme }}" id="StatsCounter-{{ section.id }}">
  <div class="section-container section-container--{{ section.settings.section_width | default: 'standard' }}">
    
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      {% render 'section-header',
        subheading: section.settings.subheading,
        subheading_style: section.settings.subheading_style,
        heading: section.settings.heading,
        heading_size: section.settings.heading_size,
        description: section.settings.description,
        alignment: section.settings.heading_alignment
      %}
    {%- endif -%}

    <div class="stats-counter__grid stats-counter__grid--d-{{ columns_desktop }}">
      {%- for block in section.blocks -%}
        <div class="stats-counter__item text-center" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != 'none' -%}
            <div class="stats-counter__icon">
              {% render 'icon-library', icon: block.settings.icon %}
            </div>
          {%- endif -%}

          <div class="stats-counter__number">
            {{ block.settings.number | escape }}
          </div>

          {%- if block.settings.label != blank -%}
            <h3 class="stats-counter__label">
              {{ block.settings.label | escape }}
            </h3>
          {%- endif -%}

          {%- if block.settings.subtext != blank -%}
            <p class="stats-counter__subtext">
              {{ block.settings.subtext | escape }}
            </p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

  </div>
</div>

<style>
  #StatsCounter-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_mobile | default: 40 }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile | default: 40 }}px;
  }

  @media (min-width: 768px) {
    #StatsCounter-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_desktop | default: 80 }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop | default: 80 }}px;
    }
  }

  #StatsCounter-{{ section.id }}.color-scheme-4,
  #StatsCounter-{{ section.id }}.color-scheme-5,
  #StatsCounter-{{ section.id }}.color-scheme-accent {
    background: radial-gradient(circle at 50% 20%, #151928 0%, #090a0f 100%);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .stats-counter__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.5rem 1.5rem;
  }

  @media (min-width: 900px) {
    .stats-counter__grid--d-2 { grid-template-columns: repeat(2, 1fr); gap: 3rem; }
    .stats-counter__grid--d-3 { grid-template-columns: repeat(3, 1fr); gap: 3rem; }
    .stats-counter__grid--d-4 { grid-template-columns: repeat(4, 1fr); gap: 2.5rem; }
  }

  .stats-counter__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 1.5rem 1rem;
  }

  .stats-counter__icon {
    margin-bottom: 0.85rem;
    color: #e2b170;
  }

  .stats-counter__icon svg {
    width: 26px;
    height: 26px;
  }

  .stats-counter__number {
    font-size: clamp(1.65rem, 2.6vw, 2.35rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: var(--color-heading, #ffffff);
    margin-bottom: 0.5rem;
    white-space: nowrap;
  }

  .stats-counter__label {
    font-size: 0.95rem;
    font-weight: 600;
    margin: 0 0 0.25rem 0;
    color: var(--color-heading, #ffffff);
  }

  .stats-counter__subtext {
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--color-subtext, #9ca3af);
    margin: 0;
    max-width: 220px;
  }
</style>

{% schema %}
{
  "name": "Stats & Milestones",
  "class": "shopify-section-stats-counter",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "By The Numbers"
    },
    {
      "type": "select",
      "id": "subheading_style",
      "label": "Subheading style",
      "options": [
        { "value": "plain", "label": "Plain" },
        { "value": "pill", "label": "Pill badge" }
      ],
      "default": "pill"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Commitment In Tangible Metrics"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "sm", "label": "Small" },
        { "value": "md", "label": "Medium" },
        { "value": "lg", "label": "Large" }
      ],
      "default": "md"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Layout & Style"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "options": [
        { "value": "2", "label": "2 Columns" },
        { "value": "3", "label": "3 Columns" },
        { "value": "4", "label": "4 Columns" }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Container width",
      "options": [
        { "value": "standard", "label": "Standard (1240px)" },
        { "value": "wide", "label": "Wide (1440px)" }
      ],
      "default": "standard"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "color-scheme-1", "label": "Clean White" },
        { "value": "color-scheme-2", "label": "Soft Warm" },
        { "value": "color-scheme-4", "label": "Deep Charcoal" },
        { "value": "color-scheme-5", "label": "Onyx Black" },
        { "value": "color-scheme-accent", "label": "Brand Accent" }
      ],
      "default": "color-scheme-4"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 140,
      "step": 10,
      "unit": "px",
      "label": "Desktop top padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 140,
      "step": 10,
      "unit": "px",
      "label": "Desktop bottom padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 80,
      "step": 10,
      "unit": "px",
      "label": "Mobile top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 80,
      "step": 10,
      "unit": "px",
      "label": "Mobile bottom padding",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Statistic",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "leaf", "label": "Leaf (Eco)" },
            { "value": "heart", "label": "Heart (Love)" },
            { "value": "shield-check", "label": "Shield Check" },
            { "value": "award", "label": "Award" }
          ],
          "default": "sparkle"
        },
        {
          "type": "text",
          "id": "number",
          "label": "Metric / Number",
          "default": "99.6%"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Metric title",
          "default": "Satisfaction Rating"
        },
        {
          "type": "text",
          "id": "subtext",
          "label": "Short note",
          "default": "Based on 14,000+ verified customer reviews"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Stats & Milestones",
      "blocks": [
        {
          "type": "stat",
          "settings": {
            "icon": "sparkle",
            "number": "99.6%",
            "label": "Satisfaction Rate",
            "subtext": "From verified client reviews worldwide"
          }
        },
        {
          "type": "stat",
          "settings": {
            "icon": "leaf",
            "number": "100%",
            "label": "Organic Fibers",
            "subtext": "GOTS certified & ethically cultivated"
          }
        },
        {
          "type": "stat",
          "settings": {
            "icon": "shield-check",
            "number": "10-Year",
            "label": "Warranty Program",
            "subtext": "Guaranteed craftsmanship against defects"
          }
        },
        {
          "type": "stat",
          "settings": {
            "icon": "award",
            "number": "32+",
            "label": "Design Accolades",
            "subtext": "Recognized across international design salons"
          }
        }
      ]
    }
  ]
}
{% endschema %}

{% comment %}
  PREMIUM RICH TEXT / EDITORIAL MANIFESTO
  Flexible text block for brand storytelling, announcements, and mission statements.
{% endcomment %}

{%- liquid
  assign alignment = section.settings.alignment | default: 'center'
  assign container_width = section.settings.container_width | default: 'narrow'
  assign color_scheme = section.settings.color_scheme | default: 'color-scheme-1'
-%}

<div class="rich-text {{ color_scheme }}" id="RichText-{{ section.id }}">
  <div class="section-container section-container--{{ container_width }}">
    <div class="rich-text__wrapper rich-text__wrapper--{{ alignment }}{% if section.settings.show_accent_line %} rich-text__wrapper--accent{% endif %}">
      
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'subheading' -%}
            <span class="rich-text__subheading{% if block.settings.subheading_pill %} rich-text__subheading--pill{% endif %}" {{ block.shopify_attributes }}>
              {{ block.settings.subheading | escape }}
            </span>

          {%- when 'heading' -%}
            <h2 class="rich-text__heading rich-text__heading--{{ block.settings.heading_size | default: 'lg' }}" {{ block.shopify_attributes }}>
              {{ block.settings.heading | escape }}
            </h2>

          {%- when 'text' -%}
            <div class="rich-text__text rte" {{ block.shopify_attributes }}>
              {{ block.settings.text }}
            </div>

          {%- when 'buttons' -%}
            <div class="rich-text__buttons" {{ block.shopify_attributes }}>
              {%- if block.settings.button_1_label != blank -%}
                <a href="{{ block.settings.button_1_link | default: routes.all_products_collection_url }}" class="btn btn--{{ block.settings.button_1_style | default: 'primary' }} btn--lg">
                  {{ block.settings.button_1_label | escape }}
                </a>
              {%- endif -%}
              {%- if block.settings.button_2_label != blank -%}
                <a href="{{ block.settings.button_2_link | default: routes.all_products_collection_url }}" class="btn btn--{{ block.settings.button_2_style | default: 'outline' }} btn--lg">
                  {{ block.settings.button_2_label | escape }}
                </a>
              {%- endif -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}

    </div>
  </div>
</div>

<style>
  #RichText-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_mobile | default: 40 }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile | default: 40 }}px;
  }

  @media (min-width: 768px) {
    #RichText-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_desktop | default: 80 }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop | default: 80 }}px;
    }
  }

  .rich-text__wrapper {
    position: relative;
    max-width: 100%;
  }

  .rich-text__wrapper--center {
    text-align: center;
    margin-left: auto;
    margin-right: auto;
  }

  .rich-text__wrapper--left {
    text-align: left;
  }

  .rich-text__wrapper--right {
    text-align: right;
    margin-left: auto;
  }

  .rich-text__wrapper--accent.rich-text__wrapper--left {
    padding-left: 1.75rem;
    border-left: 3px solid currentColor;
  }

  .rich-text__subheading {
    display: inline-block;
    font-size: 0.825rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-subtext, #6b7280);
    margin-bottom: 1rem;
  }

  .rich-text__subheading--pill {
    padding: 0.35rem 0.95rem;
    border-radius: var(--radius-full);
    background: rgba(0, 0, 0, 0.05);
  }

  .rich-text__heading {
    margin: 0 0 1.25rem 0;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--color-heading, #111827);
  }

  .rich-text__heading--sm { font-size: clamp(1.5rem, 2.5vw, 2.25rem); }
  .rich-text__heading--md { font-size: clamp(1.85rem, 3.5vw, 2.75rem); }
  .rich-text__heading--lg { font-size: clamp(2.25rem, 4.5vw, 3.5rem); }
  .rich-text__heading--xl { font-size: clamp(2.75rem, 6vw, 4.5rem); }

  .rich-text__text {
    font-size: clamp(1.05rem, 1.4vw, 1.25rem);
    line-height: 1.75;
    color: var(--color-subtext, #4b5563);
    margin-bottom: 2rem;
  }

  .rich-text__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }

  .rich-text__wrapper--center .rich-text__buttons {
    justify-content: center;
  }

  .rich-text__wrapper--right .rich-text__buttons {
    justify-content: flex-end;
  }
</style>

{% schema %}
{
  "name": "Rich text",
  "class": "shopify-section-rich-text",
  "settings": [
    {
      "type": "select",
      "id": "alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "Content width",
      "options": [
        { "value": "narrow", "label": "Narrow (820px)" },
        { "value": "standard", "label": "Standard (1240px)" },
        { "value": "wide", "label": "Wide (1440px)" }
      ],
      "default": "narrow"
    },
    {
      "type": "checkbox",
      "id": "show_accent_line",
      "label": "Show editorial border accent (left layout)",
      "default": false
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "color-scheme-1", "label": "Clean White" },
        { "value": "color-scheme-2", "label": "Soft Warm" },
        { "value": "color-scheme-3", "label": "Muted Slate" },
        { "value": "color-scheme-4", "label": "Deep Charcoal" },
        { "value": "color-scheme-5", "label": "Onyx Black" }
      ],
      "default": "color-scheme-1"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 140,
      "step": 10,
      "unit": "px",
      "label": "Desktop top padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 140,
      "step": 10,
      "unit": "px",
      "label": "Desktop bottom padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 80,
      "step": 10,
      "unit": "px",
      "label": "Mobile top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 80,
      "step": 10,
      "unit": "px",
      "label": "Mobile bottom padding",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "subheading",
      "name": "Subheading",
      "settings": [
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading",
          "default": "Our Commitment"
        },
        {
          "type": "checkbox",
          "id": "subheading_pill",
          "label": "Display as pill badge",
          "default": false
        }
      ]
    },
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Beauty In Simplicity. Quality Without Compromise."
        },
        {
          "type": "select",
          "id": "heading_size",
          "label": "Heading size",
          "options": [
            { "value": "sm", "label": "Small" },
            { "value": "md", "label": "Medium" },
            { "value": "lg", "label": "Large" },
            { "value": "xl", "label": "Extra Large" }
          ],
          "default": "lg"
        }
      ]
    },
    {
      "type": "text",
      "name": "Description",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>We believe that true luxury lies in restraint and longevity. By stripping away the superfluous and honoring raw materiality, we create objects designed to enrich daily ritual.</p>"
        }
      ]
    },
    {
      "type": "buttons",
      "name": "Buttons",
      "settings": [
        {
          "type": "text",
          "id": "button_1_label",
          "label": "Primary button label",
          "default": "Explore Our Story"
        },
        {
          "type": "url",
          "id": "button_1_link",
          "label": "Primary button link"
        },
        {
          "type": "select",
          "id": "button_1_style",
          "label": "Primary button style",
          "options": [
            { "value": "primary", "label": "Primary Solid" },
            { "value": "secondary", "label": "Secondary" },
            { "value": "outline", "label": "Outline" }
          ],
          "default": "primary"
        },
        {
          "type": "text",
          "id": "button_2_label",
          "label": "Secondary button label"
        },
        {
          "type": "url",
          "id": "button_2_link",
          "label": "Secondary button link"
        },
        {
          "type": "select",
          "id": "button_2_style",
          "label": "Secondary button style",
          "options": [
            { "value": "primary", "label": "Primary Solid" },
            { "value": "secondary", "label": "Secondary" },
            { "value": "outline", "label": "Outline" }
          ],
          "default": "outline"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Rich text",
      "blocks": [
        {
          "type": "subheading",
          "settings": {
            "subheading": "Our Heritage"
          }
        },
        {
          "type": "heading",
          "settings": {
            "heading": "Crafting Modern Antiques For Everyday Living"
          }
        },
        {
          "type": "text",
          "settings": {
            "text": "<p>From ethical fiber sourcing to precision finishing, our pieces are conceived to outlive ephemeral trends and be passed down for generations.</p>"
          }
        },
        {
          "type": "buttons",
          "settings": {
            "button_1_label": "Discover The Atelier"
          }
        }
      ]
    }
  ]
}
{% endschema %}

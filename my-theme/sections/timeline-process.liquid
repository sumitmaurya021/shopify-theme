{% comment %}
  PREMIUM TIMELINE & PROCESS STEPS
  Showcase "How It Works", production steps, or brand milestones in a connected timeline.
{% endcomment %}

{%- liquid
  assign color_scheme = section.settings.color_scheme | default: 'color-scheme-1'
-%}

<div class="timeline-process {{ color_scheme }}" id="Timeline-{{ section.id }}">
  <div class="section-container section-container--{{ section.settings.section_width | default: 'standard' }}">
    
    {% render 'section-header',
      subheading: section.settings.subheading,
      subheading_style: section.settings.subheading_style,
      heading: section.settings.heading,
      heading_size: section.settings.heading_size,
      description: section.settings.description,
      alignment: section.settings.heading_alignment,
      button_label: section.settings.button_label,
      button_link: section.settings.button_link,
      button_style: section.settings.button_style
    %}

    <div class="timeline-process__track">
      {%- for block in section.blocks -%}
        <div class="timeline-process__step" {{ block.shopify_attributes }}>
          <div class="timeline-process__marker-wrap">
            <span class="timeline-process__marker">
              {{ forloop.index }}
            </span>
          </div>

          <div class="timeline-process__content card-base card-base--bordered">
            {%- if block.settings.image != blank -%}
              <div class="timeline-process__image-wrapper">
                {{ block.settings.image | image_url: width: 600 | image_tag:
                  class: 'timeline-process__image',
                  loading: 'lazy',
                  alt: block.settings.title | escape
                }}
              </div>
            {%- endif -%}

            <h3 class="timeline-process__title">{{ block.settings.title | escape }}</h3>
            <div class="timeline-process__text rte">
              {{ block.settings.text }}
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>

  </div>
</div>

<style>
  #Timeline-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_mobile | default: 40 }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile | default: 40 }}px;
  }

  @media (min-width: 768px) {
    #Timeline-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_desktop | default: 80 }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop | default: 80 }}px;
    }
  }

  .timeline-process__track {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    position: relative;
  }

  @media (min-width: 900px) {
    .timeline-process__track {
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 1.75rem;
    }

    /* Horizontal connector bar */
    .timeline-process__track::before {
      content: '';
      position: absolute;
      top: 24px;
      left: 10%;
      right: 10%;
      height: 2px;
      background-color: var(--color-border, #e5e7eb);
      z-index: 1;
    }
  }

  .timeline-process__step {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
  }

  .timeline-process__marker-wrap {
    display: flex;
    justify-content: center;
    margin-bottom: 1.5rem;
  }

  .timeline-process__marker {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-full);
    background-color: var(--color-heading, #111827);
    color: var(--color-card-bg, #ffffff);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.15rem;
    font-weight: 800;
    box-shadow: 0 0 0 6px var(--color-card-bg, #ffffff);
  }

  .timeline-process__content {
    padding: 2rem 1.5rem;
    flex: 1;
    display: flex;
    flex-direction: column;
    text-align: center;
    background: var(--color-card-bg, #ffffff);
  }

  .timeline-process__image-wrapper {
    border-radius: var(--radius-md);
    overflow: hidden;
    margin-bottom: 1.25rem;
    aspect-ratio: 16 / 10;
  }

  .timeline-process__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .timeline-process__title {
    margin: 0 0 0.65rem 0;
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--color-heading, #111827);
  }

  .timeline-process__text {
    font-size: 0.925rem;
    line-height: 1.6;
    color: var(--color-subtext, #4b5563);
    margin: 0;
  }
</style>

{% schema %}
{
  "name": "Timeline & How it works",
  "class": "shopify-section-timeline",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Simple & Transparent"
    },
    {
      "type": "select",
      "id": "subheading_style",
      "label": "Subheading style",
      "options": [
        { "value": "plain", "label": "Plain" },
        { "value": "pill", "label": "Pill badge" }
      ],
      "default": "pill"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How Our Custom Process Works"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "sm", "label": "Small" },
        { "value": "md", "label": "Medium" },
        { "value": "lg", "label": "Large" }
      ],
      "default": "md"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Style & Spacing"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Container width",
      "options": [
        { "value": "standard", "label": "Standard (1240px)" },
        { "value": "wide", "label": "Wide (1440px)" }
      ],
      "default": "standard"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "color-scheme-1", "label": "Clean White" },
        { "value": "color-scheme-2", "label": "Soft Warm" },
        { "value": "color-scheme-3", "label": "Muted Slate" }
      ],
      "default": "color-scheme-2"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 140,
      "step": 10,
      "unit": "px",
      "label": "Desktop top padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 140,
      "step": 10,
      "unit": "px",
      "label": "Desktop bottom padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 80,
      "step": 10,
      "unit": "px",
      "label": "Mobile top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 80,
      "step": 10,
      "unit": "px",
      "label": "Mobile bottom padding",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Process Step",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Step photo (optional)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Step title",
          "default": "Step 1: Consultation"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Step description",
          "default": "<p>Select your silhouette, preferred palette, and schedule a tailored digital consultation with our style team.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Timeline & How it works",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "1. Select Your Capsule",
            "text": "<p>Explore our seasonal core collection tailored to your lifestyle and climate.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "2. Artisanal Crafting",
            "text": "<p>Each piece is cut, assembled, and finished by master Italian artisans.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "3. Doorstep Arrival",
            "text": "<p>Delivered in luxury eco-packaging with complimentary 30-day trial and returns.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}

{% comment %}
  PREMIUM IMAGE WITH TEXT SECTION
  Versatile editorial section with Split, Overlap, and Stacked layout options.
{% endcomment %}

{%- liquid
  assign layout_preset = section.settings.layout | default: 'image_first'
  assign image_ratio = section.settings.image_ratio | default: 'portrait'
  assign color_scheme = section.settings.color_scheme | default: 'color-scheme-1'
  assign image_width = section.settings.image_width | default: '50'
-%}

<div class="image-with-text {{ color_scheme }}" id="ImageWithText-{{ section.id }}">
  <div class="section-container section-container--{{ section.settings.section_width | default: 'standard' }}">
    
    <div class="image-with-text__grid image-with-text__grid--{{ layout_preset }} image-with-text__grid--width-{{ image_width }}{% if section.settings.reverse_mobile %} image-with-text__grid--reverse-mobile{% endif %}">
      
      <div class="image-with-text__media-col">
        <div class="image-with-text__media-wrapper image-with-text__media-wrapper--{{ image_ratio }}">
          {%- if section.settings.image != blank -%}
            <picture>
              {%- if section.settings.mobile_image != blank -%}
                <source media="(max-width: 767px)" srcset="{{ section.settings.mobile_image | image_url: width: 800 }}">
              {%- endif -%}
              {{ section.settings.image | image_url: width: 1400 | image_tag:
                class: 'image-with-text__image',
                loading: 'lazy',
                widths: '360, 540, 720, 960, 1200, 1400',
                alt: section.settings.heading | default: shop.name | escape
              }}
            </picture>
          {%- else -%}
            <div class="image-with-text__placeholder">
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {%- endif -%}
        </div>
      </div>

      <div class="image-with-text__text-col">
        <div class="image-with-text__content card-base{% if section.settings.card_style == 'elevated' %} card-base--elevated{% elsif section.settings.card_style == 'bordered' %} card-base--bordered{% endif %}">
          {%- if section.settings.subheading != blank -%}
            <span class="image-with-text__subheading{% if section.settings.subheading_pill %} image-with-text__subheading--pill{% endif %}">
              {{ section.settings.subheading | escape }}
            </span>
          {%- endif -%}

          {%- if section.settings.heading != blank -%}
            <h2 class="image-with-text__heading image-with-text__heading--{{ section.settings.heading_size | default: 'md' }}">
              {{ section.settings.heading | escape }}
            </h2>
          {%- endif -%}

          {%- if section.settings.text != blank -%}
            <div class="image-with-text__text rte">
              {{ section.settings.text }}
            </div>
          {%- endif -%}

          {%- if section.settings.button_label != blank -%}
            <div class="image-with-text__actions">
              <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="btn btn--{{ section.settings.button_style | default: 'primary' }}">
                {{ section.settings.button_label | escape }}
              </a>
            </div>
          {%- endif -%}
        </div>
      </div>

    </div>

  </div>
</div>

<style>
  #ImageWithText-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_mobile | default: 40 }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile | default: 40 }}px;
  }

  @media (min-width: 768px) {
    #ImageWithText-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_desktop | default: 80 }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop | default: 80 }}px;
    }
  }

  .image-with-text__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: center;
  }

  @media (min-width: 900px) {
    .image-with-text__grid--width-50 {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }

    .image-with-text__grid--width-40 {
      grid-template-columns: 4fr 6fr;
      gap: 4rem;
    }

    .image-with-text__grid--width-60 {
      grid-template-columns: 6fr 4fr;
      gap: 4rem;
    }

    .image-with-text__grid--text_first .image-with-text__media-col {
      order: 2;
    }

    .image-with-text__grid--text_first .image-with-text__text-col {
      order: 1;
    }

    /* Overlap Layout */
    .image-with-text__grid--overlap {
      position: relative;
    }

    .image-with-text__grid--overlap .image-with-text__text-col {
      margin-left: -4rem;
      z-index: 2;
    }

    .image-with-text__grid--overlap.image-with-text__grid--text_first .image-with-text__text-col {
      margin-left: 0;
      margin-right: -4rem;
    }
  }

  @media (max-width: 767px) {
    .image-with-text__grid--reverse-mobile {
      display: flex;
      flex-direction: column-reverse;
    }
  }

  .image-with-text__media-wrapper {
    position: relative;
    width: 100%;
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .image-with-text__media-wrapper--square { aspect-ratio: 1 / 1; }
  .image-with-text__media-wrapper--portrait { aspect-ratio: 4 / 5; }
  .image-with-text__media-wrapper--landscape { aspect-ratio: 16 / 10; }
  .image-with-text__media-wrapper--adapt { aspect-ratio: auto; }

  .image-with-text__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .image-with-text__media-wrapper:hover .image-with-text__image {
    transform: scale(1.03);
  }

  .image-with-text__placeholder {
    width: 100%;
    height: 100%;
    min-height: 420px;
    background: radial-gradient(circle at 50% 35%, #ffffff 0%, #ebe7de 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-lg);
    border: 1px solid rgba(0, 0, 0, 0.06);
  }

  .image-with-text__placeholder svg {
    width: 60%;
    height: 60%;
    fill: #78716c;
    stroke: #78716c;
    filter: drop-shadow(0 12px 20px rgba(0, 0, 0, 0.08));
  }

  .image-with-text__content {
    padding: 1.5rem 0;
  }

  .card-base--elevated.image-with-text__content,
  .card-base--bordered.image-with-text__content {
    padding: 3rem 2.5rem;
    background: var(--color-card-bg, #ffffff);
    border: 1px solid var(--color-card-border, var(--color-border, #edebe6));
    border-radius: var(--radius-xl);
    box-shadow: 0 20px 45px -12px rgba(0, 0, 0, 0.08);
  }

  .image-with-text__subheading {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-subtext, #6b7280);
    margin-bottom: 0.75rem;
  }

  .image-with-text__subheading--pill {
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-full);
    background: rgba(0, 0, 0, 0.06);
  }

  .image-with-text__heading {
    margin: 0 0 1rem 0;
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: -0.025em;
    color: var(--color-heading, #111827);
  }

  .image-with-text__heading--sm { font-size: clamp(1.25rem, 1.8vw, 1.5rem); }
  .image-with-text__heading--md { font-size: clamp(1.5rem, 2.2vw, 1.85rem); }
  .image-with-text__heading--lg { font-size: clamp(1.75rem, 2.8vw, 2.25rem); }

  .image-with-text__text {
    margin-bottom: 1.75rem;
    line-height: 1.6;
    font-size: clamp(0.95rem, 1.2vw, 1.05rem);
    color: var(--color-subtext, #4b5563);
  }

  .image-with-text__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
</style>

{% schema %}
{
  "name": "Image with text",
  "class": "shopify-section-image-with-text",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Desktop layout",
      "options": [
        { "value": "image_first", "label": "Image first, text second" },
        { "value": "text_first", "label": "Text first, image second" },
        { "value": "overlap", "label": "Editorial overlap card" }
      ],
      "default": "image_first"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section container width",
      "options": [
        { "value": "standard", "label": "Standard (1240px)" },
        { "value": "wide", "label": "Wide (1440px)" },
        { "value": "narrow", "label": "Narrow (820px)" }
      ],
      "default": "standard"
    },
    {
      "type": "select",
      "id": "image_width",
      "label": "Desktop image proportion",
      "options": [
        { "value": "40", "label": "40% Image / 60% Text" },
        { "value": "50", "label": "50% Image / 50% Text" },
        { "value": "60", "label": "60% Image / 40% Text" }
      ],
      "default": "50"
    },
    {
      "type": "checkbox",
      "id": "reverse_mobile",
      "label": "Show text above image on mobile",
      "default": false
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image (optional)"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image aspect ratio",
      "options": [
        { "value": "adapt", "label": "Adapt to image" },
        { "value": "portrait", "label": "Portrait (4:5)" },
        { "value": "square", "label": "Square (1:1)" },
        { "value": "landscape", "label": "Landscape (16:10)" }
      ],
      "default": "portrait"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Our Philosophy"
    },
    {
      "type": "checkbox",
      "id": "subheading_pill",
      "label": "Display subheading as pill badge",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Thoughtful Design, Consciously Crafted"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "sm", "label": "Small" },
        { "value": "md", "label": "Medium" },
        { "value": "lg", "label": "Large" }
      ],
      "default": "md"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Description",
      "default": "<p>Every garment is conceived with architectural precision and tailored using traceable, organic materials to ensure unparalleled durability, comfort, and tactile elegance.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Read Our Story"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "primary", "label": "Primary Solid" },
        { "value": "secondary", "label": "Secondary" },
        { "value": "outline", "label": "Outline" }
      ],
      "default": "primary"
    },
    {
      "type": "header",
      "content": "Style & Colors"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "color-scheme-1", "label": "Clean White" },
        { "value": "color-scheme-2", "label": "Soft Warm" },
        { "value": "color-scheme-3", "label": "Muted Slate" },
        { "value": "color-scheme-4", "label": "Deep Charcoal" },
        { "value": "color-scheme-5", "label": "Onyx Black" }
      ],
      "default": "color-scheme-1"
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "Content card style",
      "options": [
        { "value": "flat", "label": "Flat / Seamless" },
        { "value": "bordered", "label": "Bordered box" },
        { "value": "elevated", "label": "Elevated card with shadow" }
      ],
      "default": "flat"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 140,
      "step": 10,
      "unit": "px",
      "label": "Desktop top padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 140,
      "step": 10,
      "unit": "px",
      "label": "Desktop bottom padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 80,
      "step": 10,
      "unit": "px",
      "label": "Mobile top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 80,
      "step": 10,
      "unit": "px",
      "label": "Mobile bottom padding",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Image with text",
      "settings": {
        "subheading": "Artisanal Heritage",
        "heading": "Craftsmanship You Can Feel",
        "text": "<p>Designed for those who appreciate understated refinement and intentional living.</p>",
        "button_label": "Discover The Process"
      }
    }
  ]
}
{% endschema %}

{% comment %}
  PREMIUM BEFORE / AFTER INTERACTIVE COMPARISON SLIDER
  Ideal for cosmetics, skincare, restorations, transformations, tailoring, and performance wear.
{% endcomment %}

{%- liquid
  assign layout = section.settings.layout | default: 'split'
  assign color_scheme = section.settings.color_scheme | default: 'color-scheme-1'
-%}

<div class="before-after-section {{ color_scheme }}" id="BeforeAfter-{{ section.id }}">
  <div class="section-container section-container--{{ section.settings.section_width | default: 'standard' }}">
    
    <div class="before-after-section__grid before-after-section__grid--{{ layout }}">
      
      {%- comment -%} Interactive Slider Column {%- endcomment -%}
      <div class="before-after-section__slider-col">
        <div 
          class="before-after" 
          data-before-after
          style="--clip-pos: {{ section.settings.starting_position | default: 50 }}%;"
        >
          {%- comment -%} Before Media (Background) {%- endcomment -%}
          <div class="before-after__image-wrapper before-after__image-wrapper--before">
            {%- if section.settings.before_image != blank -%}
              {{ section.settings.before_image | image_url: width: 1400 | image_tag:
                class: 'before-after__img',
                loading: 'lazy',
                alt: section.settings.before_label | default: 'Before' | escape
              }}
            {%- else -%}
              <div class="before-after__placeholder" style="background: #374151;">
                {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
            {%- endif -%}
            <span class="before-after__badge before-after__badge--before">
              {{ section.settings.before_label | default: 'Before' }}
            </span>
          </div>

          {%- comment -%} After Media (Foreground Clipped) {%- endcomment -%}
          <div class="before-after__image-wrapper before-after__image-wrapper--after">
            {%- if section.settings.after_image != blank -%}
              {{ section.settings.after_image | image_url: width: 1400 | image_tag:
                class: 'before-after__img',
                loading: 'lazy',
                alt: section.settings.after_label | default: 'After' | escape
              }}
            {%- else -%}
              <div class="before-after__placeholder" style="background: #111827;">
                {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
            {%- endif -%}
            <span class="before-after__badge before-after__badge--after">
              {{ section.settings.after_label | default: 'After' }}
            </span>
          </div>

          {%- comment -%} Draggable Handle {%- endcomment -%}
          <div class="before-after__handle" aria-hidden="true">
            <div class="before-after__handle-btn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="8 4 4 8 8 12"></polyline><polyline points="16 12 20 16 16 20"></polyline></svg>
            </div>
          </div>
        </div>
      </div>

      {%- comment -%} Editorial Text Column {%- endcomment -%}
      <div class="before-after-section__text-col">
        <div class="before-after-section__content">
          {%- if section.settings.subheading != blank -%}
            <span class="before-after-section__subheading{% if section.settings.subheading_pill %} before-after-section__subheading--pill{% endif %}">
              {{ section.settings.subheading | escape }}
            </span>
          {%- endif -%}

          {%- if section.settings.heading != blank -%}
            <h2 class="before-after-section__heading before-after-section__heading--{{ section.settings.heading_size | default: 'md' }}">
              {{ section.settings.heading | escape }}
            </h2>
          {%- endif -%}

          {%- if section.settings.text != blank -%}
            <div class="before-after-section__text rte">
              {{ section.settings.text }}
            </div>
          {%- endif -%}

          {%- if section.settings.button_label != blank -%}
            <div class="before-after-section__actions">
              <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="btn btn--{{ section.settings.button_style | default: 'primary' }} btn--lg">
                {{ section.settings.button_label | escape }}
              </a>
            </div>
          {%- endif -%}
        </div>
      </div>

    </div>

  </div>
</div>

<style>
  #BeforeAfter-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_mobile | default: 40 }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile | default: 40 }}px;
  }

  @media (min-width: 768px) {
    #BeforeAfter-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_desktop | default: 80 }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop | default: 80 }}px;
    }
  }

  .before-after-section__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 900px) {
    .before-after-section__grid--split {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 4.5rem;
    }

    .before-after-section__grid--split-reverse {
      grid-template-columns: 0.85fr 1.15fr;
      gap: 4.5rem;
    }

    .before-after-section__grid--split-reverse .before-after-section__slider-col {
      order: 2;
    }
    .before-after-section__grid--split-reverse .before-after-section__text-col {
      order: 1;
    }

    .before-after-section__grid--stacked {
      grid-template-columns: 1fr;
      max-width: 1000px;
      margin: 0 auto;
      text-align: center;
    }
  }

  .before-after__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.35;
  }

  .before-after-section__subheading {
    display: inline-block;
    font-size: 0.825rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-subtext, #6b7280);
    margin-bottom: 0.85rem;
  }

  .before-after-section__subheading--pill {
    padding: 0.35rem 0.95rem;
    border-radius: var(--radius-full);
    background: rgba(0, 0, 0, 0.05);
  }

  .before-after-section__heading {
    margin: 0 0 1rem 0;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: var(--color-heading, #111827);
  }

  .before-after-section__heading--sm { font-size: clamp(1.5rem, 2.5vw, 2rem); }
  .before-after-section__heading--md { font-size: clamp(1.85rem, 3.5vw, 2.75rem); }
  .before-after-section__heading--lg { font-size: clamp(2.25rem, 4.5vw, 3.5rem); }

  .before-after-section__text {
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--color-subtext, #4b5563);
    margin-bottom: 1.75rem;
  }

  .before-after-section__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .before-after-section__grid--stacked .before-after-section__actions {
    justify-content: center;
  }
</style>

{% schema %}
{
  "name": "Before & After comparison",
  "class": "shopify-section-before-after",
  "settings": [
    {
      "type": "header",
      "content": "Images & Slider"
    },
    {
      "type": "image_picker",
      "id": "before_image",
      "label": "Before image"
    },
    {
      "type": "text",
      "id": "before_label",
      "label": "Before badge label",
      "default": "Before"
    },
    {
      "type": "image_picker",
      "id": "after_image",
      "label": "After image"
    },
    {
      "type": "text",
      "id": "after_label",
      "label": "After badge label",
      "default": "After"
    },
    {
      "type": "range",
      "id": "starting_position",
      "min": 10,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Starting slider position",
      "default": 50
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout style",
      "options": [
        { "value": "split", "label": "Split (Slider left, text right)" },
        { "value": "split-reverse", "label": "Split reverse (Text left, slider right)" },
        { "value": "stacked", "label": "Stacked centered" }
      ],
      "default": "split"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Visible Transformation"
    },
    {
      "type": "checkbox",
      "id": "subheading_pill",
      "label": "Display subheading as pill badge",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "See The Difference In Just 14 Days"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "sm", "label": "Small" },
        { "value": "md", "label": "Medium" },
        { "value": "lg", "label": "Large" }
      ],
      "default": "md"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Description",
      "default": "<p>Drag the slider to observe how our cold-pressed botanical formula restores texture, hydration, and radiance.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop The Routine"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "primary", "label": "Primary Solid" },
        { "value": "secondary", "label": "Secondary" },
        { "value": "outline", "label": "Outline" }
      ],
      "default": "primary"
    },
    {
      "type": "header",
      "content": "Style & Spacing"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Container width",
      "options": [
        { "value": "standard", "label": "Standard (1240px)" },
        { "value": "wide", "label": "Wide (1440px)" }
      ],
      "default": "standard"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "color-scheme-1", "label": "Clean White" },
        { "value": "color-scheme-2", "label": "Soft Warm" },
        { "value": "color-scheme-3", "label": "Muted Slate" }
      ],
      "default": "color-scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 140,
      "step": 10,
      "unit": "px",
      "label": "Desktop top padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 140,
      "step": 10,
      "unit": "px",
      "label": "Desktop bottom padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 80,
      "step": 10,
      "unit": "px",
      "label": "Mobile top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 80,
      "step": 10,
      "unit": "px",
      "label": "Mobile bottom padding",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Before & After comparison",
      "settings": {
        "subheading": "Proven Results",
        "heading": "Unretouched Clinical Results",
        "before_label": "Untreated",
        "after_label": "Day 14"
      }
    }
  ]
}
{% endschema %}

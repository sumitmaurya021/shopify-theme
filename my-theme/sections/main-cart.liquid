{% comment %}
  PREMIUM SHOPIFY MAIN CART SECTION
  Features:
  - Live Ajax Quantity Controls & Item Removal (Zero Page Flickers)
  - Free Shipping Progress Bar with Celebration State
  - Desktop Sticky Order Summary Card
  - Responsive Mobile Item Card Stack
  - Cart-Level & Line-Level Discounts Display
  - Order Notes Auto-Saving
  - Trust & Payment Security Badges
  - Luxury Empty State with Curated Recommendations
{% endcomment %}

<div 
  class="cart-page page-width" 
  id="MainCart" 
  data-section-id="{{ section.id }}"
>
  <div class="cart-page__header">
    <div class="cart-page__header-title-wrap">
      <h1 class="cart-page__title">Shopping Cart</h1>
      <span class="cart-page__count-badge" id="CartPageCountBadge">({{ cart.item_count }} {{ cart.item_count | pluralize: 'item', 'items' }})</span>
    </div>
    <a href="{{ routes.all_products_collection_url }}" class="cart-page__continue-link">
      &larr; Continue shopping
    </a>
  </div>

  {%- if section.settings.enable_free_shipping and cart.item_count > 0 -%}
    {%- liquid
      assign threshold_cents = section.settings.free_shipping_threshold | times: 100
      assign remaining_cents = threshold_cents | minus: cart.total_price
      assign progress_percent = cart.total_price | times: 100.0 | divided_by: threshold_cents
      assign is_unlocked = false
      if cart.total_price >= threshold_cents
        assign is_unlocked = true
        assign progress_percent = 100
      endif
    -%}

    <div class="cart-page__shipping-bar-wrap">
      <div 
        class="cart-shipping-bar{% if is_unlocked %} is-unlocked{% endif %}" 
        data-cart-page-shipping-bar 
        data-threshold="{{ threshold_cents }}"
      >
        <div class="cart-shipping-bar__message">
          {%- if is_unlocked -%}
            <span class="cart-shipping-bar__success">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
              {{ section.settings.free_shipping_success_text | default: 'Congratulations! You unlocked Free Shipping!' }}
            </span>
          {%- else -%}
            <span>
              Add <strong>{{ remaining_cents | money }}</strong> more to unlock Free Shipping!
            </span>
          {%- endif -%}
        </div>
        <div class="cart-shipping-bar__track">
          <div 
            class="cart-shipping-bar__fill" 
            style="width: {{ progress_percent }}%;"
          ></div>
        </div>
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} Inline Error Display Banner for Cart Page {%- endcomment -%}
  <div class="cart-page__error-banner" id="CartPageError" role="alert" hidden style="display: none;">
    <span class="cart-page__error-text" data-error-text></span>
    <button type="button" class="cart-page__error-close" data-error-dismiss aria-label="Dismiss error">&times;</button>
  </div>

  {%- if cart.item_count > 0 -%}
    <div class="cart-page__layout">
      
      {%- comment -%} 1. CART ITEMS LIST / TABLE {%- endcomment -%}
      <div class="cart-page__items-wrapper">
        <table class="cart-table" role="table">
          <thead class="cart-table__head">
            <tr>
              <th scope="col" class="cart-table__heading cart-table__heading--product">Product</th>
              <th scope="col" class="cart-table__heading cart-table__heading--price">Price</th>
              <th scope="col" class="cart-table__heading cart-table__heading--quantity">Quantity</th>
              <th scope="col" class="cart-table__heading cart-table__heading--total">Total</th>
            </tr>
          </thead>
          <tbody class="cart-table__body">
            {%- for item in cart.items -%}
              <tr class="cart-table__row" data-cart-item-key="{{ item.key }}" data-line-index="{{ forloop.index }}">
                
                <td class="cart-table__cell cart-table__cell--product">
                  <div class="cart-table__product-info">
                    <a href="{{ item.url }}" class="cart-table__image-link">
                      {%- if item.image -%}
                        {{ item.image | image_url: width: 220 | image_tag:
                          class: 'cart-table__image',
                          loading: 'lazy',
                          widths: '80, 140, 220',
                          alt: item.title | escape
                        }}
                      {%- else -%}
                        <div class="cart-table__placeholder">
                          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                        </div>
                      {%- endif -%}
                    </a>
                    
                    <div class="cart-table__details">
                      {%- if item.product.vendor != blank -%}
                        <span class="cart-table__vendor">{{ item.product.vendor }}</span>
                      {%- endif -%}

                      <h4 class="cart-table__title">
                        <a href="{{ item.url }}">{{ item.product.title | escape }}</a>
                      </h4>

                      {%- unless item.product.has_only_default_variant -%}
                        <div class="cart-table__variants">
                          {%- for option in item.options_with_values -%}
                            <span class="cart-table__variant-pill">{{ option.name }}: {{ option.value }}</span>
                          {%- endfor -%}
                        </div>
                      {%- endunless -%}

                      {%- if item.selling_plan_allocation -%}
                        <p class="cart-table__selling-plan">
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg>
                          <span>{{ item.selling_plan_allocation.selling_plan.name }}</span>
                        </p>
                      {%- endif -%}

                      {%- assign property_size = item.properties | size -%}
                      {%- if property_size > 0 -%}
                        <div class="cart-table__properties">
                          {%- for p in item.properties -%}
                            {%- assign first_character_in_key = p.first | truncate: 1, '' -%}
                            {%- unless p.last == blank or first_character_in_key == '_' -%}
                              <div class="cart-table__property">
                                <span class="property-label">{{ p.first }}:</span>
                                {%- if p.last contains '/uploads/' -%}
                                  <a href="{{ p.last }}" target="_blank" class="property-link">View File</a>
                                {%- else -%}
                                  <span class="property-value">{{ p.last }}</span>
                                {%- endif -%}
                              </div>
                            {%- endunless -%}
                          {%- endfor -%}
                        </div>
                      {%- endif -%}

                      {%- if item.line_level_discount_allocations.size > 0 -%}
                        <ul class="cart-table__discounts" role="list">
                          {%- for discount_allocation in item.line_level_discount_allocations -%}
                            <li class="cart-table__discount-badge">
                              <span>{{ discount_allocation.discount_application.title }} (-{{ discount_allocation.amount | money }})</span>
                            </li>
                          {%- endfor -%}
                        </ul>
                      {%- endif -%}

                      <button 
                        type="button" 
                        class="cart-table__remove-btn" 
                        data-cart-page-remove="{{ item.key }}"
                        aria-label="Remove {{ item.title | escape }} from cart"
                      >
                        Remove
                      </button>
                    </div>
                  </div>
                </td>

                <td class="cart-table__cell cart-table__cell--price" data-label="Price">
                  <div class="cart-table__price-wrap">
                    {%- if item.original_price != item.final_price -%}
                      <s class="cart-table__compare-price">{{ item.original_price | money }}</s>
                      <span class="cart-table__current-price">{{ item.final_price | money }}</span>
                    {%- else -%}
                      <span class="cart-table__current-price">{{ item.final_price | money }}</span>
                    {%- endif -%}

                    {%- if item.unit_price_measurement -%}
                      <div class="cart-table__unit-price">
                        {{ item.unit_price | money }}/
                        {%- if item.unit_price_measurement.reference_value != 1 -%}
                          {{- item.unit_price_measurement.reference_value -}}
                        {%- endif -%}
                        {{ item.unit_price_measurement.reference_unit }}
                      </div>
                    {%- endif -%}
                  </div>
                </td>

                <td class="cart-table__cell cart-table__cell--quantity" data-label="Quantity">
                  <div class="cart-drawer-item__quantity-selector">
                    <button 
                      type="button" 
                      class="qty-btn qty-btn--minus" 
                      data-cart-page-minus 
                      data-cart-key="{{ item.key }}"
                      aria-label="Decrease quantity of {{ item.title | escape }}"
                    >&minus;</button>
                    <input 
                      type="number" 
                      name="updates[]" 
                      id="Updates_{{ item.key }}" 
                      value="{{ item.quantity }}" 
                      min="0" 
                      class="qty-input"
                      data-cart-page-input
                      data-cart-key="{{ item.key }}"
                      aria-label="Quantity for {{ item.title | escape }}"
                    >
                    <button 
                      type="button" 
                      class="qty-btn qty-btn--plus" 
                      data-cart-page-plus 
                      data-cart-key="{{ item.key }}"
                      aria-label="Increase quantity of {{ item.title | escape }}"
                    >&#43;</button>
                  </div>
                </td>

                <td class="cart-table__cell cart-table__cell--total" data-label="Total">
                  <div class="cart-table__total-wrap">
                    {%- if item.original_line_price != item.final_line_price -%}
                      <s class="cart-table__compare-price">{{ item.original_line_price | money }}</s>
                      <span class="cart-table__final-line-price">{{ item.final_line_price | money }}</span>
                    {%- else -%}
                      <span class="cart-table__final-line-price">{{ item.final_line_price | money }}</span>
                    {%- endif -%}
                  </div>
                </td>

              </tr>
            {%- endfor -%}
          </tbody>
        </table>

        {%- if section.settings.show_cart_note -%}
          <div class="cart-page__note">
            <label for="CartPageNote" class="cart-page__note-label">Special instructions for order:</label>
            <textarea 
              name="note" 
              id="CartPageNote" 
              class="cart-page__note-input" 
              placeholder="Leave a note with your order..."
              data-cart-page-note
            >{{ cart.note }}</textarea>
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} 2. STICKY ORDER SUMMARY SIDEBAR {%- endcomment -%}
      <div class="cart-page__summary">
        <div class="cart-summary-card">
          <h3 class="cart-summary-card__title">Order Summary</h3>

          {%- if cart.cart_level_discount_applications.size > 0 -%}
            <ul class="cart-summary-card__discounts" role="list">
              {%- for discount in cart.cart_level_discount_applications -%}
                <li class="cart-summary-card__discount-item">
                  <span>{{ discount.title }}</span>
                  <span>-{{ discount.total_allocated_amount | money }}</span>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}

          <div class="cart-summary-card__row">
            <span>Subtotal</span>
            <span class="cart-summary-card__price" id="CartPageSubtotal">{{ cart.total_price | money_with_currency }}</span>
          </div>

          {%- if cart.total_discount > 0 -%}
            <div class="cart-summary-card__row cart-summary-card__row--discount">
              <span>Total Savings</span>
              <span>-{{ cart.total_discount | money }}</span>
            </div>
          {%- endif -%}

          <p class="cart-summary-card__disclaimer">
            Taxes and shipping calculated at checkout.
          </p>

          <form action="{{ routes.cart_url }}" method="post" id="CartPageCheckoutForm">
            <button 
              type="submit" 
              name="checkout" 
              class="btn btn--primary cart-summary-card__checkout-btn"
              id="CartPageCheckoutBtn"
            >
              <span class="checkout-text">Proceed to Checkout</span>
              <span class="checkout-spinner" hidden>
                {% render 'icon-header', name: 'spinner', class: 'icon-spinner animate-spin' %}
              </span>
            </button>
          </form>

          {%- if section.settings.show_trust_badges -%}
            <div class="cart-summary-card__trust">
              <div class="cart-trust-item">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                <span>Encrypted 256-Bit SSL Checkout</span>
              </div>
              <div class="cart-trust-item">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path></svg>
                <span>Easy 30-Day Hassle-Free Returns</span>
              </div>
            </div>
          {%- endif -%}
        </div>
      </div>

    </div>

  {%- else -%}

    {%- comment -%} 3. LUXURY EMPTY CART STATE {%- endcomment -%}
    <div class="cart-empty-state">
      <div class="cart-empty-state__icon">
        {% render 'icon-header', name: 'cart', class: 'icon-cart-empty' %}
      </div>
      <h2 class="cart-empty-state__title">Your cart is currently empty</h2>
      <p class="cart-empty-state__subtext">
        Before you can checkout, you must add some products to your cart. Discover our latest curated collections.
      </p>
      <div class="cart-empty-state__actions">
        <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary">
          Start Shopping
        </a>
      </div>

      {%- if section.settings.featured_collection != blank -%}
        {%- assign empty_products = section.settings.featured_collection.products -%}
        {%- if empty_products.size > 0 -%}
          <div class="cart-empty-state__featured">
            <h3 class="cart-empty-state__featured-heading">Trending Right Now</h3>
            <div class="product-grid product-grid--desktop-4 product-grid--mobile-2">
              {%- for product in empty_products limit: 4 -%}
                <div class="product-grid__item">
                  {% render 'product-card', 
                    product: product, 
                    show_vendor: true,
                    show_secondary_image: true,
                    media_aspect_ratio: 'square' 
                  %}
                </div>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      {%- endif -%}
    </div>

  {%- endif -%}
</div>

{% schema %}
{
  "name": "Cart page",
  "class": "shopify-section-main-cart",
  "settings": [
    {
      "type": "header",
      "content": "Free Shipping Progress Bar"
    },
    {
      "type": "checkbox",
      "id": "enable_free_shipping",
      "label": "Enable free shipping progress bar",
      "default": true
    },
    {
      "type": "number",
      "id": "free_shipping_threshold",
      "label": "Free shipping threshold",
      "default": 75,
      "info": "Amount in store currency (e.g. 75 for $75.00)"
    },
    {
      "type": "text",
      "id": "free_shipping_success_text",
      "label": "Unlocked message",
      "default": "Congratulations! You unlocked Free Shipping!"
    },
    {
      "type": "header",
      "content": "Order Details & Trust"
    },
    {
      "type": "checkbox",
      "id": "show_cart_note",
      "label": "Enable cart notes",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_trust_badges",
      "label": "Show security badges in order summary",
      "default": true
    },
    {
      "type": "header",
      "content": "Empty Cart Recommendations"
    },
    {
      "type": "collection",
      "id": "featured_collection",
      "label": "Empty cart featured collection"
    }
  ]
}
{% endschema %}

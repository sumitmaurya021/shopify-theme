{% comment %}
  PREMIUM IMAGE GALLERY & LOOKBOOK
  Bento or uniform photo gallery for editorial visual storytelling.
{% endcomment %}

{%- liquid
  assign layout = section.settings.layout | default: 'bento'
  assign color_scheme = section.settings.color_scheme | default: 'color-scheme-1'
-%}

<div class="image-gallery {{ color_scheme }}" id="ImageGallery-{{ section.id }}">
  <div class="section-container section-container--{{ section.settings.section_width | default: 'standard' }}">
    
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      {% render 'section-header',
        subheading: section.settings.subheading,
        subheading_style: section.settings.subheading_style,
        heading: section.settings.heading,
        heading_size: section.settings.heading_size,
        description: section.settings.description,
        alignment: section.settings.heading_alignment
      %}
    {%- endif -%}

    <div class="image-gallery__grid image-gallery__grid--{{ layout }}">
      {%- for block in section.blocks -%}
        <div class="image-gallery__item image-gallery__item--{{ forloop.index }}" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" class="image-gallery__link">{%- endif -%}
            <div class="image-gallery__media-wrapper">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 1200 | image_tag:
                  class: 'image-gallery__img',
                  loading: 'lazy',
                  widths: '360, 540, 720, 960, 1200',
                  alt: block.settings.title | default: 'Gallery image' | escape
                }}
              {%- else -%}
                <div class="image-gallery__placeholder">
                  {%- assign p_index = forloop.index | modulo: 6 | plus: 1 -%}
                  {{ 'collection-' | append: p_index | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
              {%- endif -%}

              {%- if block.settings.tag != blank or block.settings.title != blank -%}
                <div class="image-gallery__overlay">
                  {%- if block.settings.tag != blank -%}
                    <span class="image-gallery__tag badge badge--new">{{ block.settings.tag | escape }}</span>
                  {%- endif -%}
                  {%- if block.settings.title != blank -%}
                    <h3 class="image-gallery__title">{{ block.settings.title | escape }}</h3>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          {%- if block.settings.link != blank -%}</a>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>

  </div>
</div>

<style>
  #ImageGallery-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_mobile | default: 40 }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile | default: 40 }}px;
  }

  @media (min-width: 768px) {
    #ImageGallery-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_desktop | default: 80 }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop | default: 80 }}px;
    }
  }

  .image-gallery__grid {
    display: grid;
    gap: 1.25rem;
  }

  /* Uniform 3 Columns */
  .image-gallery__grid--uniform {
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .image-gallery__grid--uniform {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .image-gallery__grid--uniform {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.75rem;
    }
  }

  /* Bento Grid */
  .image-gallery__grid--bento {
    grid-template-columns: 1fr;
  }

  @media (min-width: 768px) {
    .image-gallery__grid--bento {
      grid-template-columns: repeat(3, 1fr);
      grid-auto-rows: 280px;
      gap: 1.5rem;
    }

    .image-gallery__grid--bento .image-gallery__item--1 {
      grid-column: span 2;
      grid-row: span 2;
    }

    .image-gallery__grid--bento .image-gallery__item--4 {
      grid-column: span 2;
    }
  }

  .image-gallery__link {
    display: block;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  .image-gallery__media-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 280px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background-color: #f3f4f6;
  }

  .image-gallery__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .image-gallery__media-wrapper:hover .image-gallery__img {
    transform: scale(1.05);
  }

  .image-gallery__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .image-gallery__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0) 50%, rgba(0,0,0,0.7) 100%);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    color: #ffffff;
    z-index: 2;
  }

  .image-gallery__title {
    margin: 0.5rem 0 0 0;
    font-size: 1.15rem;
    font-weight: 700;
    color: #ffffff;
  }
</style>

{% schema %}
{
  "name": "Image gallery & Lookbook",
  "class": "shopify-section-image-gallery",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Visual Diary"
    },
    {
      "type": "select",
      "id": "subheading_style",
      "label": "Subheading style",
      "options": [
        { "value": "plain", "label": "Plain" },
        { "value": "pill", "label": "Pill badge" }
      ],
      "default": "pill"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Lookbook Gallery"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "sm", "label": "Small" },
        { "value": "md", "label": "Medium" },
        { "value": "lg", "label": "Large" }
      ],
      "default": "md"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Gallery layout",
      "options": [
        { "value": "bento", "label": "Bento Asymmetric Grid" },
        { "value": "uniform", "label": "Uniform Columns" }
      ],
      "default": "bento"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Container width",
      "options": [
        { "value": "standard", "label": "Standard (1240px)" },
        { "value": "wide", "label": "Wide (1440px)" }
      ],
      "default": "standard"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "color-scheme-1", "label": "Clean White" },
        { "value": "color-scheme-2", "label": "Soft Warm" },
        { "value": "color-scheme-3", "label": "Muted Slate" }
      ],
      "default": "color-scheme-1"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 140,
      "step": 10,
      "unit": "px",
      "label": "Desktop top padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 140,
      "step": 10,
      "unit": "px",
      "label": "Desktop bottom padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 80,
      "step": 10,
      "unit": "px",
      "label": "Mobile top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 80,
      "step": 10,
      "unit": "px",
      "label": "Mobile bottom padding",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Gallery image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Badge / Tag (optional)",
          "default": "Look 01"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Caption title",
          "default": "Autumn Minimalist"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link URL (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image gallery & Lookbook",
      "blocks": [
        { "type": "image", "settings": { "tag": "Look 01", "title": "The Cashmere Trench" } },
        { "type": "image", "settings": { "tag": "Look 02", "title": "Silk Poplin Shirt" } },
        { "type": "image", "settings": { "tag": "Look 03", "title": "Structured Blazer" } },
        { "type": "image", "settings": { "tag": "Look 04", "title": "Everyday Trousers" } }
      ]
    }
  ]
}
{% endschema %}

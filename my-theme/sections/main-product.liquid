{% comment %}
  PREMIUM MAIN PRODUCT SECTION (Online Store 2.0)
  Features:
  - Advanced Media Gallery (Images, Videos, Models, Zoom, Aspect Ratio, Thumbnails)
  - Color Swatches & Pill / Dropdown Variant Pickers
  - Real-Time Variant Matching, Availability Matrix & Price Synchronization
  - Quantity Controls & Dynamic Checkout
  - Collapsible Information Accordions
  - Trust & Shipping Badges
  - Mobile Sticky Add-to-Cart Bar
  - Full Ajax Cart Drawer Integration
{% endcomment %}

{%- assign current_variant = product.selected_or_first_available_variant | default: product.variants.first -%}
{%- assign product_form_id = 'ProductForm-' | append: section.id -%}

<div 
  class="product-page page-width" 
  id="ProductSection-{{ section.id }}" 
  data-section-id="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-product-handle="{{ product.handle }}"
>
  {% render 'breadcrumbs' %}

  <div class="product-layout product-layout--gallery-{{ section.settings.gallery_layout }}">
    
    {%- comment -%} 1. ADVANCED PRODUCT MEDIA GALLERY {%- endcomment -%}
    {%- liquid
      assign ratio = 1
      if section.settings.image_ratio == 'portrait'
        assign ratio = 0.8
      elsif section.settings.image_ratio == 'adapt' and product.featured_media
        assign ratio = product.featured_media.aspect_ratio
      endif
      if ratio == 0 or ratio == nil
        assign ratio = 1
      endif
    -%}

    <div class="product-gallery product-gallery--{{ section.settings.gallery_layout }}" data-product-gallery>
      <div 
        class="product-gallery__main" 
        style="--gallery-aspect-ratio: {{ ratio }};"
        id="ProductGalleryMain-{{ section.id }}"
      >
        {%- if product.featured_media -%}
          <div class="product-gallery__active-media" id="ActiveMediaContainer-{{ section.id }}">
            {%- case product.featured_media.media_type -%}
              {%- when 'image' -%}
                {{ product.featured_media | image_url: width: 1400 | image_tag:
                  class: 'product-gallery__main-image',
                  loading: 'eager',
                  widths: '400, 600, 800, 1000, 1200, 1400',
                  id: 'ProductMainImage',
                  alt: product.featured_media.alt | default: product.title | escape
                }}
              {%- when 'video' -%}
                {{ product.featured_media | video_tag: controls: true, autoplay: false, class: 'product-gallery__video' }}
              {%- when 'external_video' -%}
                {{ product.featured_media | external_video_tag: class: 'product-gallery__video' }}
              {%- when 'model' -%}
                {{ product.featured_media | model_viewer_tag: class: 'product-gallery__model' }}
            {%- endcase -%}
          </div>

          {%- if section.settings.enable_image_zoom and product.featured_media.media_type == 'image' -%}
            <button 
              type="button" 
              class="product-gallery__zoom-btn" 
              data-gallery-zoom 
              aria-label="Zoom image"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                <line x1="11" y1="8" x2="11" y2="14"></line>
                <line x1="8" y1="11" x2="14" y2="11"></line>
              </svg>
            </button>
          {%- endif -%}

        {%- else -%}
          <div class="product-gallery__placeholder">
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endif -%}
      </div>

      {%- if product.media.size > 1 -%}
        <div class="product-gallery__thumbnails" role="tablist" aria-label="Product thumbnails">
          {%- for media in product.media -%}
            <button 
              type="button" 
              class="product-gallery__thumb{% if forloop.first %} is-active{% endif %}"
              data-media-id="{{ media.id }}"
              data-media-type="{{ media.media_type }}"
              data-target-src="{{ media | image_url: width: 1400 }}"
              role="tab"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              aria-label="Thumbnail {{ forloop.index }} of {{ product.media.size }}"
            >
              {{ media | image_url: width: 160, height: 160 | image_tag:
                class: 'product-gallery__thumb-image',
                loading: 'lazy',
                alt: media.alt | default: product.title | escape
              }}
              {%- if media.media_type != 'image' -%}
                <span class="product-gallery__thumb-badge" aria-hidden="true">
                  {%- if media.media_type == 'video' or media.media_type == 'external_video' -%}
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
                  {%- else -%}
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M21 16.5l-9 5.5-9-5.5V7.5l9-5.5 9 5.5v9z"></path></svg>
                  {%- endif -%}
                </span>
              {%- endif -%}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} 2. PRODUCT INFORMATION COLUMN (OS 2.0 BLOCKS) {%- endcomment -%}
    <div class="product-info">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          
          {%- when '@app' -%}
            <div class="product-info__block" {{ block.shopify_attributes }}>
              {% render block %}
            </div>

          {%- when 'title' -%}
            <div class="product-info__block product-info__header" {{ block.shopify_attributes }}>
              {%- if block.settings.show_vendor and product.vendor != blank -%}
                <span class="product-info__vendor">{{ product.vendor }}</span>
              {%- endif -%}
              <h1 class="product-info__title">{{ product.title | escape }}</h1>
              {%- if block.settings.show_sku and current_variant.sku != blank -%}
                <div class="product-info__sku" id="Sku-{{ section.id }}">
                  <span class="product-info__sku-label">SKU:</span>
                  <span class="product-info__sku-val">{{ current_variant.sku }}</span>
                </div>
              {%- endif -%}
            </div>

          {%- when 'price' -%}
            <div class="product-info__block product-info__price-wrapper" id="Price-{{ section.id }}" {{ block.shopify_attributes }}>
              {% render 'price', product: product, use_variant: true, price_class: 'price--large' %}
            </div>

          {%- when 'inventory_notice' -%}
            <div class="product-info__block product-info__inventory" id="Inventory-{{ section.id }}" {{ block.shopify_attributes }}>
              {%- if current_variant.available -%}
                <span class="inventory-status inventory-status--in-stock">
                  <span class="inventory-dot"></span>
                  In Stock, Ready to Ship
                </span>
              {%- else -%}
                <span class="inventory-status inventory-status--sold-out">
                  <span class="inventory-dot"></span>
                  Currently Sold Out
                </span>
              {%- endif -%}
            </div>

          {%- when 'variant_picker' -%}
            {%- unless product.has_only_default_variant -%}
              <div class="product-info__block" {{ block.shopify_attributes }}>
                <variant-selects 
                  class="product-info__variants" 
                  data-section="{{ section.id }}" 
                  data-url="{{ product.url }}"
                  data-picker-type="{{ block.settings.picker_type }}"
                >
                  {%- for option in product.options_with_values -%}
                    {%- assign downcase_name = option.name | downcase -%}
                    {%- assign is_color = false -%}
                    {%- if block.settings.enable_color_swatches and downcase_name contains 'color' or downcase_name contains 'colour' -%}
                      {%- assign is_color = true -%}
                    {%- endif -%}

                    <fieldset class="variant-picker" data-option-index="{{ forloop.index0 }}">
                      <legend class="variant-picker__legend">
                        <span class="variant-picker__label">{{ option.name }}:</span>
                        <span class="variant-picker__selected-val" data-selected-value>{{ option.selected_value }}</span>
                      </legend>

                      {%- if block.settings.picker_type == 'dropdown' and is_color == false -%}
                        <div class="variant-picker__dropdown-wrapper">
                          <select 
                            name="{{ option.name }}" 
                            class="variant-picker__select"
                            data-option-index="{{ forloop.index0 }}"
                          >
                            {%- for value in option.values -%}
                              <option 
                                value="{{ value | escape }}"
                                {% if option.selected_value == value %}selected{% endif %}
                              >
                                {{ value }}
                              </option>
                            {%- endfor -%}
                          </select>
                        </div>
                      {%- else -%}
                        <div class="variant-picker__options{% if is_color %} variant-picker__options--swatches{% endif %}">
                          {%- for value in option.values -%}
                            <label class="variant-picker__option-label">
                              <input 
                                type="radio" 
                                name="{{ option.name }}-{{ section.id }}" 
                                value="{{ value | escape }}"
                                class="variant-picker__radio visually-hidden"
                                data-option-index="{{ forloop.parentloop.index0 }}"
                                {% if option.selected_value == value %}checked{% endif %}
                              >
                              {%- if is_color -%}
                                <span 
                                  class="variant-picker__swatch" 
                                  data-swatch-color="{{ value | handleize }}"
                                  title="{{ value | escape }}"
                                  aria-label="{{ value | escape }}"
                                ></span>
                              {%- else -%}
                                <span class="variant-picker__pill">{{ value }}</span>
                              {%- endif -%}
                            </label>
                          {%- endfor -%}
                        </div>
                      {%- endif -%}
                    </fieldset>
                  {%- endfor -%}

                  <script type="application/json" id="ProductVariantsJson-{{ section.id }}">
                    {{ product.variants | json }}
                  </script>
                </variant-selects>
              </div>
            {%- endunless -%}

          {%- when 'quantity_selector' -%}
            <div class="product-info__block product-info__quantity-block" {{ block.shopify_attributes }}>
              <label for="Quantity-{{ section.id }}" class="quantity__label">{{ block.settings.label | default: 'Quantity' }}</label>
              <div class="cart-drawer-item__quantity-selector product-quantity-selector">
                <button type="button" class="qty-btn" data-product-qty-minus aria-label="Decrease quantity">&minus;</button>
                <input 
                  type="number" 
                  name="quantity" 
                  id="Quantity-{{ section.id }}" 
                  class="qty-input" 
                  value="1" 
                  min="1" 
                  form="{{ product_form_id }}"
                  data-product-qty-input
                >
                <button type="button" class="qty-btn" data-product-qty-plus aria-label="Increase quantity">&#43;</button>
              </div>
            </div>

          {%- when 'buy_buttons' -%}
            <div class="product-info__block product-info__form-wrapper" {{ block.shopify_attributes }}>
              {%- form 'product', product, id: product_form_id, class: 'product-form', data-product-form: '' -%}
                <input type="hidden" name="id" value="{{ current_variant.id }}" id="ProductVariantId-{{ section.id }}">

                <div class="product-form__buttons">
                  <button 
                    type="submit" 
                    name="add" 
                    class="btn btn--primary product-form__submit-btn" 
                    id="AddToCartBtn-{{ section.id }}"
                    {% unless current_variant.available %}disabled{% endunless %}
                  >
                    <span id="AddToCartText-{{ section.id }}">
                      {%- if current_variant.available -%}
                        Add to Cart
                      {%- else -%}
                        Sold Out
                      {%- endif -%}
                    </span>
                  </button>
                </div>

                {%- if block.settings.show_dynamic_checkout -%}
                  <div class="product-form__dynamic-checkout">
                    {{ form | payment_button }}
                  </div>
                {%- endif -%}
              {%- endform -%}
            </div>

          {%- when 'description' -%}
            {%- if product.description != blank -%}
              <div class="product-info__block product-info__description rte" {{ block.shopify_attributes }}>
                {{ product.description }}
              </div>
            {%- endif -%}

          {%- when 'collapsible_tab' -%}
            <div class="product-info__block" {{ block.shopify_attributes }}>
              <details class="product-accordion">
                <summary class="product-accordion__summary">
                  <span>{{ block.settings.heading | escape }}</span>
                  {% render 'icon-header', name: 'chevron-down', class: 'icon-chevron-down' %}
                </summary>
                <div class="product-accordion__content rte">
                  {{ block.settings.content }}
                  {%- if block.settings.page != blank -%}
                    {{ block.settings.page.content }}
                  {%- endif -%}
                </div>
              </details>
            </div>

          {%- when 'trust_badges' -%}
            <div class="product-info__block product-trust-badges" {{ block.shopify_attributes }}>
              <div class="trust-badge-item">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
                <span>Free Tracked Shipping</span>
              </div>
              <div class="trust-badge-item">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path></svg>
                <span>30-Day Easy Returns</span>
              </div>
              <div class="trust-badge-item">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                <span>Secure SSL Checkout</span>
              </div>
            </div>

          {%- when 'custom_liquid' -%}
            <div class="product-info__block" {{ block.shopify_attributes }}>
              {{ block.settings.custom_liquid }}
            </div>

        {%- endcase -%}
      {%- endfor -%}
    </div>

  </div>
</div>

{%- comment -%} 3. MOBILE STICKY ADD-TO-CART BAR {%- endcomment -%}
{%- if section.settings.enable_sticky_cart -%}
  <div class="product-sticky-bar" id="ProductStickyBar-{{ section.id }}" hidden>
    <div class="product-sticky-bar__container page-width">
      <div class="product-sticky-bar__product">
        {%- if product.featured_media -%}
          {{ product.featured_media | image_url: width: 100, height: 100 | image_tag:
            class: 'product-sticky-bar__image',
            loading: 'lazy',
            alt: product.title | escape
          }}
        {%- endif -%}
        <div class="product-sticky-bar__details">
          <span class="product-sticky-bar__title">{{ product.title | escape }}</span>
          <span class="product-sticky-bar__price" id="StickyPrice-{{ section.id }}">
            {{ current_variant.price | money }}
          </span>
        </div>
      </div>

      <button 
        type="button" 
        class="btn btn--primary product-sticky-bar__submit" 
        id="StickyAddToCartBtn-{{ section.id }}"
        {% unless current_variant.available %}disabled{% endunless %}
      >
        <span id="StickyAddToCartText-{{ section.id }}">
          {%- if current_variant.available -%}
            Add to Cart
          {%- else -%}
            Sold Out
          {%- endif -%}
        </span>
      </button>
    </div>
  </div>
{%- endif -%}

{%- comment -%} 4. FULLSCREEN / LIGHTBOX ZOOM MODAL {%- endcomment -%}
{%- if section.settings.enable_image_zoom -%}
  <dialog class="product-zoom-modal" id="ProductZoomModal-{{ section.id }}" aria-label="Product image zoom">
    <div class="product-zoom-modal__backdrop" data-zoom-close></div>
    <div class="product-zoom-modal__container">
      <button type="button" class="product-zoom-modal__close" data-zoom-close aria-label="Close zoom modal">&times;</button>
      <div class="product-zoom-modal__content">
        {%- if product.featured_media -%}
          {%- assign zoom_image_id = 'ZoomModalImage-' | append: section.id -%}
          {{ product.featured_media | image_url: width: 2400 | image_tag:
            class: 'product-zoom-modal__image',
            id: zoom_image_id,
            loading: 'lazy',
            alt: product.title | escape
          }}
        {%- endif -%}
      </div>
    </div>
  </dialog>
{%- endif -%}

{% schema %}
{
  "name": "Product details",
  "tag": "section",
  "class": "shopify-section-product",
  "settings": [
    {
      "type": "header",
      "content": "Media Gallery"
    },
    {
      "type": "select",
      "id": "gallery_layout",
      "label": "Gallery layout",
      "options": [
        { "value": "thumbnails_bottom", "label": "Thumbnails at bottom" },
        { "value": "thumbnails_left", "label": "Thumbnails at left" },
        { "value": "stacked", "label": "Stacked grid" }
      ],
      "default": "thumbnails_bottom"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "square", "label": "Square (1:1)" },
        { "value": "portrait", "label": "Portrait (4:5)" },
        { "value": "adapt", "label": "Adapt to image" }
      ],
      "default": "square"
    },
    {
      "type": "checkbox",
      "id": "enable_image_zoom",
      "label": "Enable image zoom / lightbox",
      "default": true
    },
    {
      "type": "header",
      "content": "Mobile Features"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_cart",
      "label": "Enable mobile sticky Add-to-Cart bar",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "title",
      "name": "Title",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_vendor",
          "label": "Show vendor",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_sku",
          "label": "Show SKU",
          "default": true
        }
      ]
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1
    },
    {
      "type": "inventory_notice",
      "name": "Inventory notice",
      "limit": 1
    },
    {
      "type": "variant_picker",
      "name": "Variant picker",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "picker_type",
          "label": "Selector style",
          "options": [
            { "value": "pills", "label": "Button pills" },
            { "value": "dropdown", "label": "Dropdown selects" }
          ],
          "default": "pills"
        },
        {
          "type": "checkbox",
          "id": "enable_color_swatches",
          "label": "Enable visual color swatches",
          "default": true
        }
      ]
    },
    {
      "type": "quantity_selector",
      "name": "Quantity selector",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Quantity"
        }
      ]
    },
    {
      "type": "buy_buttons",
      "name": "Buy buttons",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_dynamic_checkout",
          "label": "Show dynamic checkout button",
          "default": true
        }
      ]
    },
    {
      "type": "description",
      "name": "Description",
      "limit": 1
    },
    {
      "type": "collapsible_tab",
      "name": "Collapsible tab",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Shipping & Returns"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Free standard delivery on all orders over $75. Orders are shipped within 1-2 business days with tracking. Easy 30-day returns.</p>"
        },
        {
          "type": "page",
          "id": "page",
          "label": "Tab content from page"
        }
      ]
    },
    {
      "type": "trust_badges",
      "name": "Trust badges",
      "limit": 1
    },
    {
      "type": "custom_liquid",
      "name": "Custom Liquid",
      "settings": [
        {
          "type": "liquid",
          "id": "custom_liquid",
          "label": "Custom Liquid"
        }
      ]
    }
  ]
}
{% endschema %}

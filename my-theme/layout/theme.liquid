<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ page_title }}{% unless page_title contains shop.name %} – {{ shop.name }}{% endunless %}</title>
  {% if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% endif %}
  <link rel="canonical" href="{{ canonical_url }}">

  {%- comment -%} Global Design Tokens (CSS Custom Properties from Theme Editor) {%- endcomment -%}
  {% render 'design-tokens' %}

  {{ 'base.css' | asset_url | stylesheet_tag }}
  {{ 'section-header.css' | asset_url | stylesheet_tag }}
  {{ 'section-announcement-bar.css' | asset_url | stylesheet_tag }}
  {{ 'cart-drawer.css' | asset_url | stylesheet_tag }}
  {{ 'main-storefront.css' | asset_url | stylesheet_tag }}
  {{ 'section-library.css' | asset_url | stylesheet_tag }}

  <script src="{{ 'header.js' | asset_url }}" defer></script>
  <script src="{{ 'cart-drawer.js' | asset_url }}" defer></script>
  <script src="{{ 'quick-add.js' | asset_url }}" defer></script>
  <script src="{{ 'main-product.js' | asset_url }}" defer></script>
  <script src="{{ 'main-collection.js' | asset_url }}" defer></script>
  <script src="{{ 'section-library.js' | asset_url }}" defer></script>

  {{ content_for_header }}
</head>
<body data-link-underline="{{ settings.link_underline | default: 'hover' }}">
  {% sections 'header-group' %}

  <main id="MainContent">
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}

  {% section 'cart-drawer' %}
</body>
</html>
